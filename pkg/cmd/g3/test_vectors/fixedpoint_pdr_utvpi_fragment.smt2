(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.pdr.utvpi true)
(declare-rel Inv (Int Int))
(declare-rel Bad ())
(declare-var x Int)
(declare-var y Int)
(rule (Inv 0 0))
(rule (=> (and (Inv x y) (>= (+ x y) 0)) (Inv (+ x 1) (+ y 1))))
(rule (=> (and (Inv x y) (< (+ x y) 0)) Bad))
(query Bad)
