(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= (bvadd x y) #xa))
(assert (= (bvsub x y) #x4))
(check-sat)
(get-value ((= (bvadd x y) #xa) (= (bvsub x y) #x4)))
(push 1)
(assert (= (bvadd x y) #xb))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= (bvadd x y) #xa) (= (bvsub x y) #x4)))
