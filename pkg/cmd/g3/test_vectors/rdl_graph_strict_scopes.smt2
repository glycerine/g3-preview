(set-logic QF_RDL)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const x Real)
(assert p)
(assert (> x 0.0))
(assert (< x (/ 1.0 3.0)))
(check-sat)
(get-value ((> x 0.0) (< x (/ 1.0 3.0))))
(push 1)
(assert (>= x (/ 1.0 3.0)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((> x 0.0) (< x (/ 1.0 3.0))))
