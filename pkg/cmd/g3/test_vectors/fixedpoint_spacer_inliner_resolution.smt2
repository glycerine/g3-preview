(set-option :fixedpoint.engine spacer)
(declare-rel P (Int))
(declare-rel Goal ())
(declare-rel R (Int))
(declare-rel Bad ())
(declare-var x Int)
(rule (P 0))
(rule (P 1))
(rule (P 2))
(rule (P 3))
(rule (P 4))
(rule (=> (P 0) Goal))
(rule (=> (= x 1) (R x)))
(rule (=> (R 0) Bad))
(query Goal :print-answer true)
(query Bad)
