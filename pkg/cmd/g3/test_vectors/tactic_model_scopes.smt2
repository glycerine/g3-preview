(set-logic QF_UF)
(set-option :produce-models true)
(declare-const a Bool)
(assert a)
(check-sat-using (then simplify smt) :timeout 1000)
(get-value (a))
(push 1)
(assert (not a))
(check-sat-using (or-else fail smt))
(pop 1)
(check-sat-using (using-params smt :smt.auto-config false))
(get-value (a))
(check-sat)
(get-value (a))
