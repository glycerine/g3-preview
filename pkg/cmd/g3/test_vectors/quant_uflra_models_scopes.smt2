(set-logic UFLRA)
(set-option :produce-models true)
(declare-fun f (Real) Real)
(declare-const x Real)
(assert (forall ((t Real)) (! (>= (f t) t) :pattern ((f t)))))
(assert (= x (f 3)))
(assert (<= x 5))
(check-sat)
(get-value ((>= x 3)))
(check-sat-using uflra)
(get-value ((>= x 3)))
(push 1)
(assert (< (f 0) 0))
(check-sat)
(pop 1)
(check-sat)
(get-value ((>= x 3)))
