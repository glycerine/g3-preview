(set-option :produce-models true)
(set-option :auto_config false)
(set-option :smt.arith.ignore_int true)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(assert (= (- x y) 0))
(push 1)
(assert (= (+ x y) 1))
(check-sat-using (using-params smt :candidate_models true))
(get-value (x y))
(pop 1)
(push 1)
(assert (= (+ x y) (- 1)))
(check-sat-using (using-params smt :candidate_models true))
(get-value (x y))
(pop 1)
(push 1)
(assert (= (+ x y) 2))
(check-sat-using (using-params smt :candidate_models true))
(get-value (x y))
(pop 1)
