(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (and (>= x 100) (<= x 110) (>= y 100) (<= y 110)))
(assert (or (>= (+ x y) 219) (<= (+ x y) 201)))
(assert (not (= x y)))
(check-sat)
(get-value ((not (= x y)) (or (>= (+ x y) 219) (<= (+ x y) 201))))
