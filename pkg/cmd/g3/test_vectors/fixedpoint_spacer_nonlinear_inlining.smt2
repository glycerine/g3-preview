(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.generate_proof_trace true)
(declare-rel P (Int))
(declare-rel Q (Int))
(declare-rel Goal ())
(declare-var x Int)
(rule (P 0))
(rule (Q 0))
(rule (Q 1))
(rule (=> (and (P x) (Q x) (< x 2)) (P (+ x 1))))
(rule (=> (P 2) Goal))
(query Goal :print-answer true)
