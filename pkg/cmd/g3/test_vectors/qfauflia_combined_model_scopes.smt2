(set-logic QF_AUFLIA)
(declare-const x Int)
(declare-const y Int)
(declare-const a (Array Int Int))
(assert (= x 2))
(assert (>= y x))
(assert (<= y 4))
(assert (= (select a y) 9))
(check-sat)
(get-value (x (= (select a y) 9) (and (>= y 2) (<= y 4))))
(push 1)
(assert (> y 4))
(check-sat)
(pop 1)
(check-sat)
(get-value (x (= (select a y) 9) (and (>= y 2) (<= y 4))))
