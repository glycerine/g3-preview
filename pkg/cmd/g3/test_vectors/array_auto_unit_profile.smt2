(set-logic QF_AX)
(set-option :produce-models true)
(declare-const a (Array Bool Bool))
(assert (select a true))
(check-sat)
(get-value ((select a true)))
(push 1)
(assert (not (select a false)))
(check-sat)
(get-value ((select a true) (select a false)))
(pop 1)
(check-sat)
(get-value ((select a true)))
(push 1)
(assert (not (select a true)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((select a true)))
