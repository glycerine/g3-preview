(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(assert (= (bvadd x y) #x10))
(assert (= (bvmul x y) #x27))
(assert (= x #x0d))
(check-sat-using (then bit-blast smt))
(get-value (x y (bvudiv x y) (bvurem x y)))
(push 1)
(assert (= y #x04))
(check-sat-using (then bit-blast smt))
(pop 1)
(check-sat-using (then bit-blast smt))
(get-value (x y))
