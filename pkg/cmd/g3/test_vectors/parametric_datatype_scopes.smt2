(set-logic ALL)
(declare-datatype List (par (T) ((nil) (cons (head T) (tail (List T))))))
(declare-const xs (List Bool))
(push 1)
(assert (= xs (cons true nil)))
(assert (not (head xs)))
(check-sat)
(pop 1)
(declare-const ys (List Int))
(assert (= (head (cons true (as nil (List Bool)))) true))
(assert (= (head (cons 3 (as nil (List Int)))) 3))
(check-sat)
