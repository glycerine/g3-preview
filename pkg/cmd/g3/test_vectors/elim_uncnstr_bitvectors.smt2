(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(declare-const a (_ BitVec 4))
(declare-const b (_ BitVec 4))
(declare-const c (_ BitVec 4))
(declare-const d (_ BitVec 4))
(declare-const e (_ BitVec 4))
(assert (= (bvmul #x03 x) #x0c))
(assert (= ((_ extract 5 2) y) #xa))
(assert (= (bvnot z) #x12))
(assert (= (concat a b) #xab))
(assert (= (bvor c d) #xf))
(assert (bvule e #x0))
(check-sat-using (then elim-uncnstr smt))
(get-value ((= (bvmul #x03 x) #x0c) (= ((_ extract 5 2) y) #xa) (= (bvnot z) #x12) (= (concat a b) #xab) (= (bvor c d) #xf) (bvule e #x0)))
