(set-option :global-declarations true)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-datatypes () ((E red amber green)))
(declare-const x E)
(assert (! (= x green) :named chosen))
(check-sat-using (then dt2bv smt))
(get-value (x))
(push 1)
(assert (! (distinct x green) :named clash))
(check-sat-using (then dt2bv smt))
(get-unsat-core)
(pop 1)
(check-sat-using (then dt2bv smt))
(get-value (x))
(reset-assertions)
(assert (= x amber))
(check-sat-using (then dt2bv smt))
(get-value (x))
