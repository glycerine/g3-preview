(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-logic QF_FD)
(declare-datatypes () ((Colour red amber green)))
(declare-const colour Colour)
(declare-const n Int)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(assert (>= n -3))
(assert (<= n 3))
(assert (= (* n n) 4))
(assert (>= n 0))
(assert (= colour green))
(assert ((_ at-least 2) p q r))
(assert (not r))
(check-sat)
(get-value (n colour p q r))
(push 1)
(assert (! (<= n 1) :named too-small))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(get-value (n colour))
(reset)
(set-logic QF_FD)
(declare-const a Bool)
(assert a)
(check-sat)
(push 1)
(assert (not a))
(check-sat)
(pop 1)
(check-sat)
