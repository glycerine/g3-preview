(set-logic ALL)
(set-option :auto_config false)
(set-option :smt.arith.solver 3)
(set-option :produce-models true)
(declare-const i Int)
(declare-const r Real)
(assert (>= i 0))
(assert (<= i 1))
(assert (> r 0.0))
(assert (< r (/ 1.0 3.0)))
(check-sat)
(get-value ((>= i 0) (<= i 1) (> r 0.0) (< r (/ 1.0 3.0))))
(push 1)
(assert (<= r 0.0))
(check-sat)
(pop 1)
(check-sat)
(get-value ((>= i 0) (<= i 1) (> r 0.0) (< r (/ 1.0 3.0))))
