(set-logic QF_IDL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (and (>= x 0) (<= x 0) (>= y 0) (<= y 1) (>= z 0) (<= z 2)))
(assert (distinct x y z))
(check-sat-using qfidl)
(get-value (x y z))
(push 1)
(assert (= x z))
(check-sat-using qfidl)
(pop 1)
(check-sat-using qfidl)
(get-value (x y z))
