(set-option :produce-models true)
(set-option :sat.max_conflicts 0)
(declare-const p Bool)
(declare-const q Bool)
(assert (or p q))
(assert (not p))
(check-sat-using sat)
(get-info :reason-unknown)
(check-sat-using (using-params sat :max_conflicts 100))
(get-value (p q))
(set-option :sat.max_conflicts 100)
(check-sat-using sat)
(get-value (p q))
(set-option :sat.dimacs.display true)
(check-sat-using sat)
(get-info :reason-unknown)
(check-sat-using (using-params sat :dimacs.display false))
(get-value (p q))
(set-option :sat.dimacs.display false)
(set-option :sat.resolution false)
(set-option :sat.scc false)
(set-option :sat.asymm_branch false)
(check-sat-using (then sat-preprocess smt))
(get-value (p q))
