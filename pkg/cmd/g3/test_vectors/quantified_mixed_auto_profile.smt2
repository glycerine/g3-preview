(set-logic AUFLIRA)
(set-option :produce-models true)
(set-option :smt.ematching false)
(set-option :smt.mbqi false)
(declare-fun f (Real) Real)
(assert (forall ((x Real)) (= (f x) (+ x 1.0))))
(check-sat)
(get-value ((= (f 3.0) 4.0)))
(push 1)
(assert (distinct (f 7.0) 8.0))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= (f 7.0) 8.0)))
