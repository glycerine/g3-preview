(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (>= x 0))
(assert (<= x 5))
(assert (>= y 0))
(assert (<= y 2))
(assert (= (+ x y) 7))
(check-sat-using (then simplify lia2pb smt))
(get-value (x y))
(push 1)
(assert (< x 5))
(check-sat-using (then simplify lia2pb smt))
(pop 1)
(check-sat-using (then simplify lia2pb smt))
(get-value (x y))
