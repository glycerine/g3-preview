(set-option :fixedpoint.engine spacer)
(declare-rel P (Int Int))
(declare-rel Q (Int Int))
(declare-rel R (Int))
(declare-rel Goal ())
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(rule (P 0 1))
(rule (=> (and (P x y) (= z (+ x y))) (Q y z)))
(rule (=> (and (Q x y) (= z (+ x y))) (R z)))
(rule (=> (R 2) Goal))
(query Goal :print-answer true)
