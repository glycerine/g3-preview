(set-logic QF_IDL)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (<= (- x y) 0))
(assert (<= (- y x) 1))
(assert (<= (- x z) 0))
(assert (<= (- z x) 1))
(assert (not (= y z)))
(check-sat-using (or-else (then simplify fix-dl-var normalize-bounds diff-neq) smt))
(get-value (x y z))
(push 1)
(assert (= y z))
(check-sat-using (or-else (then simplify fix-dl-var normalize-bounds diff-neq) smt))
(pop 1)
(check-sat-using (or-else (then simplify fix-dl-var normalize-bounds diff-neq) smt))
(get-value (x y z))
