(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(assert (or (= x 1) (= x 3)))
(check-sat-using (then add-bounds smt))
(get-value (x))
(push 1)
(assert (= x 3))
(check-sat-using (then add-bounds smt))
(get-info :reason-unknown)
(pop 1)
(check-sat-using (then add-bounds smt))
(get-value (x))
