(set-logic ALL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(assert (>= x 0))
(assert (<= x 1))
(assert (>= y 0))
(assert (<= y 1))
(assert (>= z 0))
(assert (<= z 1))
(assert (>= w 0))
(assert (<= w 1))
(assert (= (+ (* 2 x) (* (- 2) y) z (* (- 1) w)) 0))
(assert (= x 1))
(assert (= z 0))
(check-sat-using (then simplify pb2bv smt))
(get-value (x y z w))
