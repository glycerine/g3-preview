(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 8))
(assert (bvsle #xfe x))
(assert (bvsle x #x02))
(assert (= ((_ extract 1 0) x) #b11))
(check-sat-using (then reduce-bv-size smt))
(get-value (x))
(push 1)
(assert (= x #x00))
(check-sat-using (then reduce-bv-size smt))
(pop 1)
(check-sat-using (then reduce-bv-size smt))
(get-value (x))
