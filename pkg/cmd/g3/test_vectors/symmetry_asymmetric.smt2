(set-logic QF_UF)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const x U)
(declare-const y U)
(declare-fun R (U U) Bool)
(assert (distinct a b))
(assert (or (= x a) (= x b)))
(assert (or (= y a) (= y b)))
(assert (R a b))
(assert (not (R b a)))
(check-sat-using (then symmetry-reduce smt))
(get-value ((R a b) (R b a)))
