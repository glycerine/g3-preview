(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(push 1)
(assert (>= (+ x y) 5))
(assert (>= (+ x y) 1))
(assert (<= (+ x y) 4))
(check-sat)
(pop 1)
(push 1)
(assert (<= (+ x y) 4))
(assert (<= (+ x y) 10))
(assert (>= (+ x y) 5))
(check-sat)
(pop 1)
(assert (>= (+ x y) 1))
(assert (<= (+ x y) 4))
(check-sat)
