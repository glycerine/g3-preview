(set-logic QF_IDL)
(set-option :produce-models true)
(declare-const x Int)
(assert (>= x 5))
(assert (<= x 7))
(assert (not (= x 5)))
(assert (not (= x 6)))
(check-sat-using (using-params qfidl :max_steps 0))
(get-info :reason-unknown)
(check-sat-using (or-else (using-params qfidl :max_steps 0) smt))
(get-value (x))
