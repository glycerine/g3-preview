(set-option :produce-models true)
(set-option :auto_config false)
(set-logic ALL)
(declare-const a Real)
(declare-const b Real)
(declare-fun f (Real) Bool)
(assert (f a))
(assert (not (f b)))
(assert (f (^ a b)))
(assert (not (f 1.0)))
(check-sat-using (using-params smt :candidate_models true))
(get-value ((f a) (f b) (f 1.0)))
(push 1)
(assert false)
(check-sat-using (using-params smt :candidate_models true))
(pop 1)
(check-sat-using (using-params smt :candidate_models true))
(get-value ((f a) (f b) (f 1.0)))
