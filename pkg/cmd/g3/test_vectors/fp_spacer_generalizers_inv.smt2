(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.spacer.use_eqclass true)
(set-option :fixedpoint.spacer.use_array_eq_generalizer true)
(set-option :fixedpoint.spacer.lemma_sanity_check true)
(declare-rel Inv ((Array Int Int) (Array Int Int)))
(declare-rel Bad ())
(declare-var a (Array Int Int))
(declare-var b (Array Int Int))
(rule (Inv ((as const (Array Int Int)) 0) ((as const (Array Int Int)) 0)))
(rule (=> (Inv a b) (Inv (store a 0 0) (store b 0 0))))
(rule (=> (and (Inv a b) (not (= a b))) Bad))
(query Bad :print-answer true)
