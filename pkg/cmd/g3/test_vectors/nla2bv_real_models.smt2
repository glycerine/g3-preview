(set-option :produce-models true)
(set-logic ALL)
(declare-const x Real)
(assert (= (* x x) 2.0))
(check-sat-using (then nla2bv simplify bit-blast sat))
(get-value ((= (* x x) 2.0)))
(push)
(assert (> x 3.0))
(check-sat-using (then nla2bv simplify bit-blast sat))
(pop)
(check-sat-using (then nla2bv simplify bit-blast sat))
(get-value ((= (* x x) 2.0)))
