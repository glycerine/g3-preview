(set-logic QF_AUFBV)
(set-option :produce-models true)
(declare-const a (Array (_ BitVec 4) (_ BitVec 8)))
(declare-const b (Array (_ BitVec 4) (_ BitVec 8)))
(declare-const i (_ BitVec 4))
(declare-const j (_ BitVec 4))
(assert (bvult i j))
(assert (= b (store (store a j #x02) i #x01)))
(check-sat-using qfaufbv)
(get-value ((= (select b i) #x01) (= (select b j) #x02) (bvult i j)))
