(set-logic ALL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(declare-const v Int)
(assert (>= x 0))
(assert (<= x 1))
(assert (>= y 0))
(assert (<= y 1))
(assert (>= z 0))
(assert (<= z 1))
(assert (>= w 0))
(assert (<= w 1))
(assert (>= v 0))
(assert (<= v 1))
(assert (>= (+ x y z w v) 3))
(assert (<= (+ x y z w v) 3))
(check-sat-using (then simplify (using-params pb2bv :pb2bv_all_clauses_limit 0 :pb2bv_cardinality_limit 99) smt))
(get-value ((= (+ x y z w v) 3)))
