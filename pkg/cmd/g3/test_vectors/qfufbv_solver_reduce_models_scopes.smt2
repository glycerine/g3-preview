(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-fun f ((_ BitVec 4) (_ BitVec 4)) (_ BitVec 4))
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (bvult x y))
(assert (bvult (f #x1 x) (f #x1 y)))
(check-sat)
(get-value ((bvult x y) (bvult (f #x1 x) (f #x1 y))))
(push 1)
(assert (= x y))
(check-sat)
(pop 1)
(check-sat)
(get-value ((bvult x y) (bvult (f #x1 x) (f #x1 y))))
