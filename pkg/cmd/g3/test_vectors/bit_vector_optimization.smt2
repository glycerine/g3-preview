(set-option :produce-models true)
(set-logic QF_BV)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))

(push)
(assert (bvule x #x9))
(maximize x)
(check-sat)
(get-objectives)
(get-value (x))
(pop)

(push)
(assert (bvuge x #x3))
(minimize x)
(check-sat)
(get-objectives)
(get-value (x))
(pop)

(push)
(assert (= (bvadd x y) #x7))
(maximize x)
(minimize y)
(check-sat)
(get-objectives)
(get-value (x y))
(pop)
