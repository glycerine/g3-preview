(set-logic QF_IDL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
; First push selects the source logic-only integer-simplex setup.
(push 1)
(assert (= x 3))
(assert (= (- x y) 2))
(check-sat)
(get-value (x y))
(push 1)
(assert (distinct y 1))
(check-sat)
(pop 1)
(check-sat)
(get-value (x y))
