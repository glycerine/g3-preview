(set-logic QF_FD)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(assert ((_ pble 3 1 2 3) p q r))
(assert ((_ pbge 3 1 2 3) p q r))
(check-sat-using (then card2bv smt))
(get-value (((_ pbeq 3 1 2 3) p q r)))
(push 1)
(assert p)
(assert q)
(assert r)
(check-sat-using (then card2bv smt))
(pop 1)
(check-sat-using (then card2bv smt))
(get-value (((_ pbeq 3 1 2 3) p q r)))
