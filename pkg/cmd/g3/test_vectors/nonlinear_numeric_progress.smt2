(set-logic QF_NIA)
(set-option :smt.arith.nl.gb false)
(set-option :smt.arith.nl.branching false)
(declare-const x Int)
(declare-const y Int)
(assert (>= x 1))
(assert (<= x 10))
(assert (>= y 1))
(assert (<= y 10))
(push 1)
(assert (= (* x y) 11))
(check-sat)
(pop 1)
(assert (= x 3))
(assert (= (* x y) 12))
(check-sat)
(get-value (x y))
