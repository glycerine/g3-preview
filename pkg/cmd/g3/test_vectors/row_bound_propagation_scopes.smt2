(set-logic QF_LRA)
(set-option :smt.arith.solver 2)
(set-option :produce-unsat-cores true)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(assert (! (> x 1) :named x_strict))
(assert (! (>= y 2) :named y_lower))
(assert (! (>= z 10) :named unrelated))
(push 1)
(assert (! (<= (+ x y) 3) :named blocked_sum))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(get-value (x y (+ x y)))
