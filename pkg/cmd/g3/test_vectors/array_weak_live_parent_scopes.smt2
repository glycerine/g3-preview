(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(set-option :smt.array.weak true)
(declare-const a (Array Bool Bool))
(declare-const b (Array Bool Bool))
(declare-const outer (Array (Array Bool Bool) Bool))
(declare-const v Bool)
(declare-const w Bool)
(assert (= b (store a true v)))
(assert (= b (store a false w)))
(check-sat)
(get-value ((= a b)))
(push 1)
(assert (distinct (select outer a) (select outer b)))
(check-sat)
(pop 1)
(set-option :smt.array.weak false)
(push 1)
(assert (distinct (select outer a) (select outer b)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= a b)))
