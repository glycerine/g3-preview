(set-logic ALL)
(set-option :auto_config false)
(set-option :smt.arith.solver 4)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (>= x (- 2)))
(assert (<= x 2))
(assert (>= y (- 2)))
(assert (<= y 2))
(push 1)
(assert (= (+ x y) 1))
(assert (= (- x y) 0))
(check-sat)
(pop 1)
(push 1)
(assert (= (+ x y) 2))
(assert (= (- x y) 0))
(check-sat)
(get-value (x y))
(push 1)
(assert (< x 1))
(check-sat)
(pop 1)
(check-sat)
(get-value (x y))
