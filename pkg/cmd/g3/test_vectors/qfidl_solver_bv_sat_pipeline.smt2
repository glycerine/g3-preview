(set-logic QF_IDL)
(set-option :produce-models true)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(assert (and (>= a 0) (<= a 1) (>= b 0) (<= b 1) (>= c 0) (<= c 1)))
(assert (or (= a 1) (= b 1)))
(assert (or (= a 0) (= b 1)))
(assert (or (= b 0) (= c 1)))
(assert (or (= a 0) (= c 0)))
(check-sat)
(get-value (a b c))
(push 1)
(assert (= b 0))
(check-sat)
(pop 1)
(check-sat)
(get-value (a b c))
