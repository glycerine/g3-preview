(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :auto_config false)
(set-option :smt.core.validate true)
(set-option :smt.pb.conflict_frequency 0)
(set-option :smt.pb.enable_compilation false)
(set-logic ALL)
(declare-const x Bool)
(declare-const y Bool)
(declare-const u Bool)
(declare-const z Bool)
(declare-const w Bool)
(define-fun A () Bool ((_ pbge 6 4 3 2) x y u))
(define-fun B () Bool ((_ pbge 4 3 2 1) (not x) z w))
(push 1)
(assert (! A :named cut_A))
(assert (! B :named cut_B))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(push 1)
(assert A)
(assert (not y))
(check-sat)
(get-value (x u A B))
(push 1)
(assert (! B :named rejected_cut))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(pop 1)
(push 1)
(assert A)
(check-sat)
(get-value (A B))
(pop 1)
(check-sat)
