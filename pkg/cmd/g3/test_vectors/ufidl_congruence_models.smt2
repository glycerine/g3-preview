(set-logic QF_UFIDL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-fun f (Int) Int)
(assert (= (f x) 5))
(assert (= (f y) 7))
(check-sat)
(get-value ((f x) (f y) (distinct x y)))
(push 1)
(assert (= x y))
(check-sat)
(pop 1)
(check-sat)
(get-value ((f x) (f y) (distinct x y)))
