(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= (bvmul x y) #x6))
(assert (bvult x y))
(assert (= (f #x0) #x1))
(check-sat-using qfufbv)
(get-value ((= (bvmul x y) #x6) (bvult x y) (= (f #x0) #x1)))
(push 1)
(assert (bvult y x))
(check-sat-using qfufbv)
(pop 1)
(check-sat-using qfufbv)
(get-value ((= (bvmul x y) #x6) (bvult x y) (= (f #x0) #x1)))
