(set-logic ALL)
(set-option :produce-unsat-cores true)
(declare-const shared String)
(declare-const u String)
(declare-const v String)
(assert (! (= shared (str.++ u v)) :named irrelevant_alias))
(push 1)
(assert (! (not (= (str.++ shared (str.++ "a" "b")) (str.++ (str.++ shared "a") "b"))) :named associative_words))
(check-sat-using smt)
(get-unsat-core)
(pop 1)
(declare-sort E 0)
(declare-const c E)
(declare-const d E)
(declare-const x (Seq E))
(declare-const y (Seq E))
(push 1)
(assert (= x (seq.unit c)))
(assert (= y (seq.unit d)))
(assert (not (= c d)))
(assert (= x y))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= x (seq.unit c)))
(assert (= y (seq.unit d)))
(assert (not (= c d)))
(assert (not (= x y)))
(check-sat-using smt)
(pop 1)
