(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(assert (= x #x1))
(assert (= y #x2))
(assert (= (f x) #x3))
(assert (= (f y) #x4))
(check-sat-using (then ackermannize_bv smt))
(get-value (x y (f x) (f y)))
(push 1)
(assert (= x y))
(check-sat-using (then ackermannize_bv smt))
(pop 1)
(check-sat-using (then ackermannize_bv smt))
(get-value ((f x) (f y)))
