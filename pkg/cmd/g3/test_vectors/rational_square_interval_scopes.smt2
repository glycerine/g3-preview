(set-logic QF_NRA)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(define-fun d () Real (+ (* x x) (* (- 2) x y) (* y y)))
(define-fun |squared difference| () Real d)
(assert (>= x (/ 2 3)))
(assert (<= x (/ 7 5)))
(assert (>= y (/ 2 3)))
(assert (<= y (/ 7 5)))
(push 1)
(assert (= (+ d (/ 11 13)) 0))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= x (/ 2 3)))
(assert (= y (/ 7 5)))
(assert (= d (/ 121 225)))
(check-sat)
(get-value (d |squared difference| (let ((q d)) (+ q 0))))
(push 1)
(assert (< d (/ 121 225)))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
