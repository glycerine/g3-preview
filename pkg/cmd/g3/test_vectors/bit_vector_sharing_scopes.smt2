(set-logic QF_UFBV)
(set-option :rewriter.flat false)
(declare-const a (_ BitVec 8))
(declare-const b (_ BitVec 8))
(declare-const c (_ BitVec 8))
(declare-const d (_ BitVec 8))
(declare-fun p ((_ BitVec 8)) Bool)
(push 1)
(assert (p (bvand a b c d)))
(assert (not (p (bvand (bvand a b) (bvand c d)))))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (p (bvand a c b d)))
(assert (not (p (bvand (bvand a c) (bvand b d)))))
(check-sat)
(pop 1)
(check-sat)
