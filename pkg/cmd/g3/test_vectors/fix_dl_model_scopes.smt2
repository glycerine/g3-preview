(set-logic QF_IDL)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(assert (<= (- x y) 2))
(assert (<= (- x z) 3))
(assert (<= (- x w) 4))
(check-sat-using (then simplify fix-dl-var smt))
(get-value (x (<= (- x y) 2)))
(push 1)
(assert (> (- x y) 2))
(check-sat-using (then simplify fix-dl-var smt))
(pop 1)
(check-sat-using (then simplify fix-dl-var smt))
(get-value (x))
