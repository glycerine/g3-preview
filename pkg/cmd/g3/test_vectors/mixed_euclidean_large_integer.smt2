(set-logic ALL)
(set-option :smt.arith.euclidean_solver true)
(declare-const x Int)
(declare-const y Int)
(declare-const r Real)
(assert (>= x 0))
(assert (<= x 2))
(assert (>= y 0))
(assert (>= r 0.25))
(assert (<= r 0.75))
(assert (= (+ (* 1267650600228229401496703205377 x) (* 2 y)) 1267650600228229401496703205379))
(check-sat)
(get-value (x y))
