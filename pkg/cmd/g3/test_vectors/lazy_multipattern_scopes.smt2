(set-option :produce-models true)
(set-logic AUFLIA)
(declare-sort U 0)
(declare-fun f (U) U)
(declare-fun g (U) U)
(declare-fun h (U) U)
(declare-fun p (U) Bool)
(declare-const c U)
(declare-const d U)
(assert (forall ((x U)) (! (p x) :pattern ((f x)) :pattern ((g x) (h x)))))
(push 1)
(assert (not (= (g c) (h c))))
(assert (not (p c)))
(check-sat-using (using-params smt :auto_config false :mbqi false))
(pop 1)
(check-sat-using (using-params smt :auto_config false :mbqi true))
(get-value ((p c)))
(push 1)
(assert (not (= (g d) (h d))))
(assert (not (p d)))
(check-sat-using (using-params smt :auto_config false :mbqi false))
(pop 1)
(check-sat-using (using-params smt :auto_config false :mbqi true))
