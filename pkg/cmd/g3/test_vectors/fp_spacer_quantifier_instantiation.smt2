(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.instantiate_quantifiers true)
(set-logic HORN)
(declare-rel p ())
(declare-rel q ())
(declare-rel r ())
(declare-var a (Array Bool Bool))
(declare-var b (Array Bool Bool))
(rule (=> (and (= (select a true) false)
               (forall ((y Bool))
                 (! (= (select a y) false)
                    :pattern ((select a y)))))
          p))
(query p)
(rule (=> (and (= (select a false) true)
               (forall ((y Bool))
                 (= (select a y) (not y))))
          q))
(query q)
(rule (=> (and (= (select a true) false)
               (= (select b true) true)
               (forall ((y Bool))
                 (! (= (select a y) (not (select b y)))
                    :pattern ((select a y) (select b y)))))
          r))
(query r)
