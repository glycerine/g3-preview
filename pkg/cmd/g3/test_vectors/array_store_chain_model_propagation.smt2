(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(set-option :smt.array.weak true)
(declare-const a (Array Bool Bool))
(declare-const b (Array Bool Bool))
(declare-const c (Array Bool Bool))
(assert (= (store a true false) b))
(assert (= (store b false true) c))
(assert (select a false))
(check-sat)
(get-value ((= b (store a true false)) (= c (store b false true)) (select b false) (select c false) (select c true)))
(push 1)
(assert (select c true))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= b (store a true false)) (= c (store b false true)) (select b false) (select c false) (select c true)))
