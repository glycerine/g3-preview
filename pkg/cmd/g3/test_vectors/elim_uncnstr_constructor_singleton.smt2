(set-logic ALL)
(declare-datatype Box ((box (val Int))))
(declare-fun f (Box) Bool)
(declare-const i Int)
(assert (f (box i)))
(check-sat-using (then elim-uncnstr smt))
(get-value ((f (box i))))
(push 1)
(declare-datatype Single ((only)))
(declare-const s Single)
(assert (not (= s only)))
(check-sat-using (then elim-uncnstr smt))
(pop 1)
(check-sat-using (then elim-uncnstr smt))
