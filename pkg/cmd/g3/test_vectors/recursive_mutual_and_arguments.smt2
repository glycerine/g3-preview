(set-option :produce-models true)
(set-logic AUFLIA)
(define-funs-rec ((even ((n Int)) Int) (odd ((n Int)) Int))
  ((ite (<= n 0) 1 (odd (- n 1)))
   (ite (<= n 0) 0 (even (- n 1)))))
(define-fun-rec choose ((flag Bool) (n Int)) Int (ite flag n (- n)))
(define-fun-rec zero () Int 0)
(define-fun-rec identity ((x Bool)) Bool x)
(assert (= (even 4) 1))
(check-sat-using (using-params smt :auto_config false))
(get-value ((even 0) (even 5) (odd 5) (choose true 7) (choose false 7) zero))
(push 1)
(assert (= (odd 4) 1))
(check-sat-using (using-params smt :auto_config false))
(pop 1)
(check-sat-using (using-params smt :auto_config false))
