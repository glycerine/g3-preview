(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 8))
(assert (= ((_ extract 7 4) x) #b1010))
(assert (= ((_ extract 3 0) x) #b0101))
(check-sat-using (then bv1-blast smt))
(get-value (x))
(push 1)
(assert (= x #x00))
(check-sat-using (then bv1-blast smt))
(pop 1)
(check-sat-using (then bv1-blast smt))
(get-value (x))
