(set-option :produce-models true)
(set-option :auto_config false)
(set-option :smt.arith.solver 0)
(set-logic ALL)
(declare-const p Bool)
(declare-fun f (Real) Bool)
(assert p)
(check-sat)
(get-value (p))
(push 1)
(assert (f 3.0))
(assert (not (f 4.0)))
(check-sat-using (using-params smt :candidate_models true))
(get-value ((f 3.0) (f 4.0)))
(push 1)
(assert false)
(check-sat-using (using-params smt :candidate_models true))
(pop 1)
(check-sat-using (using-params smt :candidate_models true))
(get-value ((f 3.0) (f 4.0)))
(pop 1)
(check-sat)
(get-value (p))
