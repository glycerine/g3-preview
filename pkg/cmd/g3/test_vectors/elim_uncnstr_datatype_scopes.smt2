(set-logic ALL)
(declare-datatypes ((Even 0) (Odd 0))
  (((empty) (even (odd-tail Odd))) ((odd (even-tail Even)))))
(declare-const e Even)
(assert (= (even-tail (odd e)) e))
(check-sat-using (then simplify elim-uncnstr smt))
(push 1)
(declare-datatype Flag ((on) (off)))
(declare-const f Flag)
(assert (is-on f))
(check-sat-using (then elim-uncnstr smt))
(get-value ((is-on f)))
(pop 1)
(check-sat-using (then simplify elim-uncnstr smt))
