(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (and (>= x 0) (<= x 1) (>= y 0) (<= y 1) (>= z 0) (<= z 1)))
(assert (>= (+ (* 2 x) (* 3 y) (* 5 z)) 7))
(assert (not (= x y)))
(check-sat)
(get-value ((>= (+ (* 2 x) (* 3 y) (* 5 z)) 7) (not (= x y))))
