(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.array_blast true)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.slice false)
(set-logic HORN)
(declare-rel goal ())
(declare-var a (Array Bool Bool))
(declare-var b (Array Bool Bool))
(rule (=> (and (= a (store b true false))
               (= (select b true) false)
               (= (select b false) true))
          goal))
(query goal)
