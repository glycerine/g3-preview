(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.slice true)
(declare-rel P (Int Int))
(declare-rel Goal ())
(declare-var x Int)
(declare-var y Int)
(rule (P x y))
(rule (=> (P x y) Goal))
(query Goal)
