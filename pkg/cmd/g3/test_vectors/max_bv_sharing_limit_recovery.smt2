(set-logic QF_BV)
(set-option :produce-models true)
(declare-const p Bool)
(assert (not p))
(check-sat-using (using-params max-bv-sharing :max_steps 0))
(get-info :reason-unknown)
(check-sat-using (or-else (using-params max-bv-sharing :max_steps 0) smt))
(get-info :reason-unknown)
(check-sat-using (then max-bv-sharing smt))
(get-value (p))
