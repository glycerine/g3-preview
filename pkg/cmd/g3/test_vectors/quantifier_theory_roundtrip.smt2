(set-option :produce-models true)
(set-logic AUFLIA)
(declare-fun p (Bool) Bool)
(declare-const a (Array Int Int))
(assert (forall ((b Bool)) (p b)))
(assert (= (select a 0) 7))
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-value ((p true) (p false) (select a 0)))
(push 1)
(assert (not (p true)))
(check-sat-using (using-params smt :auto_config false :ematching false))
(pop 1)
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-value ((p true) (p false) (select a 0)))
