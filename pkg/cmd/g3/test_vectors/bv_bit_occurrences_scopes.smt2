(set-option :auto-config false)
(set-option :produce-models true)
(set-logic ALL)
(declare-const p Bool)
(declare-const q Bool)
(define-fun x () (_ BitVec 4) (mkbv p q p (not q)))
(define-fun y () (_ BitVec 4) (mkbv (not p) (not q) (not p) q))
(assert p)
(assert (distinct x y))
(check-sat-using smt)
(get-value ((= ((_ extract 0 0) x) #b1) (= ((_ extract 2 2) x) #b1) (= ((_ extract 3 3) x) (bvnot ((_ extract 1 1) x)))))
(push)
(assert q)
(check-sat-using smt)
(get-value ((= x #x7) (= y #x8)))
(pop)
(push)
(assert (not q))
(check-sat-using smt)
(get-value ((= x #xd) (= y #x2)))
(pop)
(push)
(assert (not p))
(check-sat-using smt)
(pop)
(check-sat-using smt)
