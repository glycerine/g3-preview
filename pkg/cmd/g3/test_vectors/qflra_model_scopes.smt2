(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (> x 0))
(assert (< x (/ 1 3)))
(assert (= y (+ x (/ 1 7))))
(check-sat-using qflra)
(get-value ((and (> x 0) (< x (/ 1 3)) (= y (+ x (/ 1 7))))))
(push 1)
(assert (<= y (/ 1 7)))
(check-sat-using qflra)
(pop 1)
(check-sat-using qflra)
