(set-logic ALL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (>= x 0))
(assert (<= x 1))
(assert (>= y 0))
(assert (<= y 1))
(assert (>= z 0))
(assert (<= z 1))
(assert (or (= x 0) (>= (+ (* 2 y) (* 3 z)) 5)))
(assert (not (= x 0)))
(check-sat-using (then simplify pb2bv smt))
(get-value (x y z))
