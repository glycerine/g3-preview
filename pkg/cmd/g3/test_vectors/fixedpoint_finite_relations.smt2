(set-option :fixedpoint.engine datalog)
(declare-rel P (Bool Bool))
(declare-rel Q (Bool Bool))
(declare-var p Bool)
(declare-var q Bool)
(rule (P true false) finite-seed 0)
(rule (=> (P p q) (Q p q)))
(query Q :print-answer true)

(declare-rel B ((_ BitVec 2)))
(rule (B #b10))
(query B :print-answer true)

(declare-rel Edge ((_ BitVec 2) (_ BitVec 2)))
(declare-rel Path ((_ BitVec 2) (_ BitVec 2)))
(declare-rel Goal ())
(declare-rel U (Bool))
(declare-var x (_ BitVec 2))
(declare-var y (_ BitVec 2))
(declare-var z (_ BitVec 2))
(rule (Edge #b00 #b01))
(rule (Edge #b01 #b10))
(rule (=> (Edge x y) (Path x y)))
(rule (=> (and (Path x y) (Edge y z)) (Path x z)))
(rule (=> (Path #b00 #b10) Goal))
(query Goal :print-answer false)

(declare-rel Values ((_ BitVec 2)))
(declare-rel Filtered ((_ BitVec 2)))
(declare-rel Unbound ((_ BitVec 2)))
(declare-rel Nonzero ((_ BitVec 2)))
(declare-rel Next ((_ BitVec 2)))
(declare-rel Small ((_ BitVec 2)))
(declare-rel Advanced ((_ BitVec 2)))
(declare-rel SawTwo ())
(declare-rel SawZero ())
(declare-rel SawOne ())
(declare-rel SmallTwo ())
(declare-rel SawAdvancedThree ())
(declare-rel SawAdvancedZero ())
(rule (Values #b00))
(rule (Values #b01))
(rule (Values #b10))
(rule (=> (and (Values x) (= x #b01)) (Filtered x)))
(rule (=> (= x #b10) (Unbound x)))
(rule (=> (and (Values x) (distinct x #b00)) (Nonzero x)))
(rule (=> (and (Values x) (= (bvadd x #b01) #b11)) (Next x)))
(rule (=> (and (Values x) (bvult x #b10)) (Small x)))
(rule (=> (Values x) (Advanced (bvadd x #b01))))
(rule (=> (Nonzero #b10) SawTwo))
(rule (=> (Nonzero #b00) SawZero))
(rule (=> (Small #b01) SawOne))
(rule (=> (Small #b10) SmallTwo))
(rule (=> (Advanced #b11) SawAdvancedThree))
(rule (=> (Advanced #b00) SawAdvancedZero))
(query Filtered :print-answer true)
(query Unbound :print-answer true)
(query Nonzero :print-answer false)
(query SawTwo)
(query SawZero)
(query Next :print-answer true)
(query Advanced :print-answer false)
(query SawAdvancedThree)
(query SawAdvancedZero)
(query SawOne :print-answer false)
(query SmallTwo)

(declare-rel Domain (Bool))
(declare-rel Blocked (Bool))
(declare-rel Allowed (Bool))
(declare-rel BoolGuard ())
(rule (Domain true))
(rule (Domain false))
(rule (Blocked true))
(rule (=> (and (Domain p) (not (Blocked p))) (Allowed p)))
(rule (=> (= p false) BoolGuard))
(query Allowed :print-answer true)
(query BoolGuard :print-answer false)
(query U)
