(set-option :fixedpoint.engine datalog)
(declare-rel P (Bool Bool))
(declare-rel Q (Bool Bool))
(declare-var p Bool)
(declare-var q Bool)
(rule (P true false))
(rule (=> (P p q) (Q p q)))
(query Q :print-answer true)

(declare-rel B ((_ BitVec 2)))
(rule (B #b10))
(query B :print-answer true)

(declare-rel Edge ((_ BitVec 2) (_ BitVec 2)))
(declare-rel Path ((_ BitVec 2) (_ BitVec 2)))
(declare-rel Goal ())
(declare-rel U (Bool))
(declare-var x (_ BitVec 2))
(declare-var y (_ BitVec 2))
(declare-var z (_ BitVec 2))
(rule (Edge #b00 #b01))
(rule (Edge #b01 #b10))
(rule (=> (Edge x y) (Path x y)))
(rule (=> (and (Path x y) (Edge y z)) (Path x z)))
(rule (=> (Path #b00 #b10) Goal))
(query Goal)
(query U)
