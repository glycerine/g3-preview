(set-logic QF_AX)
(set-option :produce-models true)
(declare-const a (Array Bool Bool))
(declare-const b (Array Bool Bool))
(push 1)
(assert (distinct a b))
(check-sat)
(get-value ((distinct a b)))
(push 1)
(assert (= (select a true) (select b true)))
(assert (= (select a false) (select b false)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((distinct a b)))
