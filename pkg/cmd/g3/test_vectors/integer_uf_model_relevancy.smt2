(set-logic QF_UFLIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-fun f (Int) Int)
(assert (distinct (f x) (f y)))
(check-sat)
(get-value ((distinct x y) (distinct (f x) (f y))))
(push 1)
(assert (= x y))
(check-sat)
(pop 1)
(check-sat)
(get-value ((distinct x y) (distinct (f x) (f y))))
