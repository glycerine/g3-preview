(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(assert (>= (+ a (* 2 b) (* 4 c)) 0))
(assert (<= (+ a (* 2 b) (* 4 c)) 7))
(assert (not (= (+ a (* 2 b) (* 4 c)) 0)))
(assert (not (= (+ a (* 2 b) (* 4 c)) 1)))
(assert (not (= (+ a (* 2 b) (* 4 c)) 2)))
(assert (not (= (+ a (* 2 b) (* 4 c)) 3)))
(assert (not (= (+ a (* 2 b) (* 4 c)) 4)))
(assert (not (= (+ a (* 2 b) (* 4 c)) 5)))
(assert (<= 0 a))
(assert (<= a 1))
(assert (<= 0 b))
(assert (<= b 1))
(assert (<= 0 c))
(assert (<= c 1))
(check-sat-using smt)
(get-value ((and (>= (+ a (* 2 b) (* 4 c)) 6) (<= (+ a (* 2 b) (* 4 c)) 7))))
(push 1)
(assert (<= (+ a (* 2 b) (* 4 c)) 5))
(check-sat-using smt)
(pop 1)
(check-sat-using smt)
(get-value ((and (>= (+ a (* 2 b) (* 4 c)) 6) (<= (+ a (* 2 b) (* 4 c)) 7))))
