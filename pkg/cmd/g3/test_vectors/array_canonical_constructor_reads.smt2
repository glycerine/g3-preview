(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(declare-sort U 0)
(declare-const i U)
(declare-const j U)
(declare-const a (Array U Bool))
(declare-const b (Array U Bool))
(declare-const c (Array U Bool))
(declare-fun f (U) Bool)
(push 1)
(assert (= a ((as const (Array U Bool)) true)))
(assert (= b ((_ map not) a)))
(check-sat)
(get-value ((select a i) (select b j)))
(push 1)
(assert (= i j))
(assert (not (select a j)))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (select b j))
(check-sat)
(pop 1)
(push 1)
(assert (= c (_ as-array f)))
(assert (f i))
(assert (not (select c i)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((select a i) (select b j)))
