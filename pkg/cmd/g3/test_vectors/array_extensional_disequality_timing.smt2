(set-logic QF_AX)
(set-option :smt.array.extensional false)
(declare-const a (Array Bool Bool))
(declare-const b (Array Bool Bool))
(declare-const p Bool)
(assert (or (= a b) p))
(check-sat)
(set-option :smt.array.extensional true)
(push 1)
(assert (distinct a b))
(assert (= (select a true) (select b true)))
(assert (= (select a false) (select b false)))
(check-sat)
(pop 1)
(check-sat)
(set-option :smt.array.extensional false)
(push 1)
(assert (distinct a b))
(assert (= (select a true) (select b true)))
(assert (= (select a false) (select b false)))
(check-sat)
(pop 1)
(check-sat)
