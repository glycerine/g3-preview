(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-fun f ((_ BitVec 4) (_ BitVec 4)) (_ BitVec 8))
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= (f #x0 x) #x11))
(assert (= (f #x1 y) #x22))
(check-sat-using (then reduce-args smt))
(get-value ((f #x0 x) (f #x1 y)))
(push 1)
(assert (not (= (f #x0 x) #x11)))
(check-sat-using (then reduce-args smt))
(pop 1)
(check-sat-using (then reduce-args smt))
(get-value ((f #x0 x) (f #x1 y)))
