(set-logic ALL)
(declare-const x String)
(declare-const y String)

(push)
(assert (= (str.++ x "a") "ba"))
(assert (not (= x "b")))
(check-sat)
(pop)

(push)
(assert (= (str.++ x y) "abc"))
(assert (= (str.len x) 1))
(assert (= (str.len y) 2))
(check-sat)
(pop)

(push)
(assert (= (str.++ x "a") "b"))
(check-sat)
(pop)

(push)
(assert (= (str.++ x "a") (str.++ "a" x)))
(assert (= (str.len x) 3))
(check-sat)
(pop)

(push)
(assert (= x "abc"))
(assert (not (str.prefixof "ab" x)))
(check-sat)
(pop)

(push)
(assert (= x "abc"))
(assert (not (str.suffixof "bc" x)))
(check-sat)
(pop)

(push)
(assert (= x "abc"))
(assert (not (str.contains x "b")))
(check-sat)
(pop)

(push)
(assert (= x "abc"))
(assert (not (= (str.at x 1) "b")))
(check-sat)
(pop)

(push)
(assert (= x "abc"))
(assert (not (= (str.substr x 1 2) "bc")))
(check-sat)
(pop)

(push)
(assert (= x "abcabc"))
(assert (not (= (str.indexof x "bc" 1) 1)))
(check-sat)
(pop)

(push)
(assert (= x "abcabc"))
(assert (not (= (str.replace x "bc" "Z") "aZabc")))
(check-sat)
(pop)

(push)
(assert (str.in.re x (re.++ (str.to.re "ab") (re.* (str.to.re "c")))))
(assert (= (str.len x) 4))
(assert (not (= x "abcc")))
(check-sat)
(pop)

(push)
(assert (str.in.re x (re.inter (re.* (re.union (str.to.re "a") (str.to.re "b"))) (re.++ (str.to.re "a") (re.* (str.to.re "b"))))))
(assert (= (str.len x) 3))
(check-sat)
(pop)
