(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= x #x7))
(assert (= y #x3))
(check-sat)
(get-value ((bvadd x y) (bvsub x y)))
(push 1)
(assert (= (bvadd x y) #xb))
(check-sat)
(pop 1)
(check-sat)
(get-value ((bvadd x y) (bvsub x y)))
