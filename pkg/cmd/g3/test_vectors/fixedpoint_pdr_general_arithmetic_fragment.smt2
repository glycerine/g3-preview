(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.pdr.utvpi true)
(declare-rel Inv (Int Int Int))
(declare-rel Bad ())
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(rule (Inv 0 0 0))
(rule (=> (and (Inv x y z) (>= (+ x y z) 0)) (Inv (+ x 1) (+ y 1) (+ z 1))))
(rule (=> (and (Inv x y z) (< (+ x y z) 0)) Bad))
(query Bad)
