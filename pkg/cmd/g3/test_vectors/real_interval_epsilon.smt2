(set-option :produce-models true)
(set-option :auto_config false)
(set-logic QF_LRA)
(declare-const x Real)
(assert (> x 0))
(assert (< x 1))
(check-sat-using smt)
(get-value (x))
(push 1)
(assert (< x (/ 1.0 2.0)))
(check-sat-using smt)
(get-value (x))
(push 1)
(assert (<= x 0))
(check-sat-using smt)
(pop 1)
(check-sat-using smt)
(get-value (x))
(pop 1)
(check-sat-using smt)
(get-value (x))
