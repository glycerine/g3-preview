(set-logic QF_UF)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(assert (or p q))
(assert (= q r))
(assert (not r))
(check-sat-using (then aig smt))
(get-value (p q r))
(push 1)
(assert (not p))
(check-sat-using (then aig smt))
(pop 1)
(check-sat-using (then (using-params aig :aig_per_assertion false) smt))
(get-value (p q r))
