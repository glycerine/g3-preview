(set-logic ALL)
(declare-const c1 Bool)
(declare-const c2 Bool)
(declare-const c3 Bool)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(assert (= (ite c1 x y) 4))
(assert (= (ite c2 z 2) 5))
(assert (= (ite c3 2 w) 6))
