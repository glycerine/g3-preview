(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.spacer.elim_aux false)
(set-option :fixedpoint.spacer.reach_dnf false)
(declare-rel P (Int))
(declare-rel Goal ())
(declare-rel U ())
(declare-var x Int)
(rule (P 0))
(rule (=> (and (P x) (< x 2)) (P (+ x 1))))
(rule (=> (P 2) Goal))
(query Goal :print-answer true)
(query U :print-answer false)
