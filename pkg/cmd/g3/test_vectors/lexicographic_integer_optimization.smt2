(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(assert (and (>= x 0) (<= x 3) (>= y 0) (<= (+ x y) 5)))
(push)
(maximize x)
(maximize y)
(check-sat)
(get-objectives)
(get-value (x y))
(pop)
(push)
(minimize x)
(maximize y)
(check-sat)
(get-objectives)
(get-value (x y))
(pop)
