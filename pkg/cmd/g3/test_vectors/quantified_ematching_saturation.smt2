(set-option :auto-config false)
(set-option :smt.mbqi false)
(set-logic AUFLIA)
(declare-fun r (Int Int) Bool)
(assert (forall ((x Int) (y Int) (z Int))
 (! (=> (and (r x y) (r y z)) (r x z)) :pattern ((r x y) (r y z)))))
(check-sat)
(push 1)
(assert (r 1 2))
(assert (r 2 3))
(assert (not (r 1 3)))
(check-sat)
(pop 1)
(check-sat)
