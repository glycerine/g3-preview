(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(assert (and (>= x 0) (<= x 1) (>= y 0) (<= y 1) (>= z 0) (<= z 1) (>= w 0) (<= w 1)))
(assert (>= (+ (* 7 x) (* 5 y) (* 3 z) (* 2 w)) 17))
(check-sat-using (then (using-params pb2bv :pb2bv_all_clauses_limit 0 :pb2bv_cardinality_limit 0) max-bv-sharing bit-blast aig smt))
(get-value (x y z w))
