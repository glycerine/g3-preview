(set-option :auto-config false)
(set-option :produce-models true)
(set-option :smt.relevancy 2)
(set-logic ALL)
(declare-const x Int)
(declare-const b (_ BitVec 4))
(assert (> x (- 18)))
(assert (< x (- 16)))
(assert (= b ((_ int2bv 4) x)))
(check-sat-using smt)
(get-value ((= b #xf) (= (bv2int b) 15) (= (bv2int (bvnot b)) 0)))
(push)
(assert (bvule b #xe))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(push)
(assert (not (= ((_ int2bv 4) (+ x 17)) #x0)))
(check-sat-using smt)
(pop)
(check-sat-using smt)
