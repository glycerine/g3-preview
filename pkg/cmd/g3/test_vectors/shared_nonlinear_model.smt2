(set-logic QF_UFNRA)
(set-option :produce-models true)
(set-option :smt.arith.nl.gb false)
(declare-fun f (Real) Real)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(assert (= x (* 2 y)))
(assert (>= y 1))
(assert (<= y 2))
(assert (>= z (- 1)))
(assert (<= z 1))
(assert (= (* x z) (- 2)))
(assert (= (f z) 0))
(check-sat)
(push 1)
(assert (= (f (- 1)) 1))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= z (- 1)))
(check-sat)
(get-value (x y z (f z)))
(pop 1)
