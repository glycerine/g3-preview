(set-option :auto-config false)
(set-option :produce-models true)
(set-logic ALL)
(declare-const p Bool)
(declare-const q Bool)
(declare-fun f ((_ BitVec 4)) Bool)
(assert p)
(assert (not q))
(assert (f (mkbv p (not q) true false)))
(assert (not (f #x5)))
(check-sat-using smt)
(get-value ((f #x7) (f #x5) (= (mkbv p (not q) true false) #x7)))
(push)
(assert q)
(check-sat-using smt)
(pop)
(check-sat-using smt)
