(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.coalesce_rules true)
(set-option :fixedpoint.xform.unfold_rules 1)
(declare-rel Q (Int))
(declare-rel P (Int))
(declare-rel Goal ())
(declare-var x Int)
(rule (Q 0))
(rule (=> (and (Q x) (= x 0)) (P x)))
(rule (=> (and (Q x) (= x 1)) (P x)))
(rule (=> (P 0) Goal))
(query Goal)
