(set-logic HORN)
(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.pdr.farkas false)
(set-option :fixedpoint.pdr.use_convex_closure_generalizer true)
(set-option :fixedpoint.pdr.use_convex_interior_generalizer true)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(declare-rel Inv (Int))
(declare-rel Bad ())
(declare-var x Int)
(rule (Inv 0))
(rule (=> (and (Inv x) (< x 10)) (Inv (+ x 1))))
(rule (=> (and (Inv x) (> x 10)) Bad))
(query Bad :print-answer true)
