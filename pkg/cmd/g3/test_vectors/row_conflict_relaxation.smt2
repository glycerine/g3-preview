(set-option :produce-proofs true)
(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(declare-const unrelated Real)
(assert (>= unrelated 77.0))
(push 1)
(assert (>= (+ x y) 10.0))
(assert (<= x 1.0))
(assert (<= y 2.0))
(assert (>= (+ x y) 5.0))
(assert (<= x 4.0))
(assert (<= y 4.0))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(declare-const fresh Real)
(assert (>= fresh 0.0))
(assert (>= (+ x y) 10.0))
(assert (<= x 6.0))
(assert (<= y 6.0))
(check-sat)
(pop 1)
