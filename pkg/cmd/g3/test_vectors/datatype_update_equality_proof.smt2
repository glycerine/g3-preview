(set-option :produce-proofs true)
(set-option :auto_config false)
(set-logic ALL)
(declare-sort U 0)
(declare-datatypes () ((Choice none (box (first U) (second U)))))
(declare-const u U)
(declare-const x Choice)
(assert ((_ is box) x))
(assert (distinct (first ((_ update-field first) x u)) u))
(check-sat)
(get-proof)
