(set-logic ALL)
(set-option :auto_config false)
(declare-sort U 0)
(declare-const i U)
(declare-const a (Array U Bool))
(declare-fun f (U) Bool)
(push 1)
(assert (= a (_ as-array f)))
(check-sat-using qfauflia)
(push 1)
(assert (f i))
(assert (not (select a i)))
(check-sat-using qfauflia)
(pop 1)
(check-sat-using qfauflia)
