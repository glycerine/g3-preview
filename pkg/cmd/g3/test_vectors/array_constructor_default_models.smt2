(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(declare-const a (Array Bool Bool))
(declare-const b (Array Bool Bool))
(assert (= a ((as const (Array Bool Bool)) true)))
(assert (= b (store a false false)))
(check-sat)
(get-value ((= a ((as const (Array Bool Bool)) true)) (= b (store a false false)) (select a true) (select b false) (select b true)))
(push 1)
(assert (not (select b true)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= a ((as const (Array Bool Bool)) true)) (= b (store a false false)) (select a true) (select b false) (select b true)))
