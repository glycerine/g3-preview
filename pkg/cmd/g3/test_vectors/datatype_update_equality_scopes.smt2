(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-logic ALL)
(declare-sort U 0)
(declare-datatypes () ((Choice none (box (first U) (second U)))))
(declare-const u U)
(declare-const v U)
(declare-const x Choice)
(define-fun changed () Choice ((_ update-field first) x u))
(push 1)
(assert (! ((_ is box) x) :named matching))
(assert (= (second x) v))
(check-sat)
(get-value ((= (first changed) u) (= (second changed) v)))
(push 1)
(assert (! (distinct (first changed) u) :named bad_field))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(pop 1)
(push 1)
(assert (! (= x none) :named empty))
(assert (! (distinct changed x) :named bad_identity))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(declare-datatypes () ((One (single (field U)))))
(declare-const only One)
(define-fun changed-one () One ((_ update-field field) only v))
(assert (= (field only) u))
(check-sat)
(get-value ((= (field changed-one) v)))
(push 1)
(assert (distinct (field changed-one) v))
(check-sat)
(pop 1)
(check-sat)
