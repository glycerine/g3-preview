(set-option :auto-config false)
(set-option :produce-models true)
(set-logic ALL)
(declare-const b0 Bool)
(declare-const b1 Bool)
(declare-const b2 Bool)
(declare-const b3 Bool)
(declare-const b4 Bool)
(define-fun x () (_ BitVec 4) (mkbv b3 b2 b1 b0))
(define-fun y () (_ BitVec 4) (mkbv b4 b3 b2 b1))
(assert (= x y))
(push)
(assert b0)
(check-sat-using smt)
(get-value (b0 b1 b2 b3 b4 (= x #xf) (= y #xf)))
(push)
(assert (not b4))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(pop)
(push)
(assert (not b4))
(check-sat-using smt)
(get-value (b0 b1 b2 b3 b4 (= x #x0) (= y #x0)))
(pop)
(check-sat-using smt)
