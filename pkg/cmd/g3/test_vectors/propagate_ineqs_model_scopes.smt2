(set-logic QF_LRA)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(assert (>= x 2))
(assert (<= x 2))
(assert (>= (+ y (* (- 1) x)) 3))
(assert (<= y 5))
(check-sat-using (then (using-params simplify :arith_lhs true) propagate-ineqs smt))
(get-value (x y))
(push 1)
(assert (> y 5))
(check-sat-using (then (using-params simplify :arith_lhs true) propagate-ineqs smt))
(pop 1)
(check-sat-using (then (using-params simplify :arith_lhs true) propagate-ineqs smt))
(get-value (x y))
