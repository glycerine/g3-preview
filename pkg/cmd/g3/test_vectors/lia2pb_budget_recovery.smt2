(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(assert (>= x 0))
(assert (<= x 7))
(assert (not (= x 0)))
(assert (not (= x 1)))
(assert (not (= x 2)))
(assert (not (= x 3)))
(assert (not (= x 4)))
(assert (not (= x 5)))
(check-sat-using (then simplify (using-params lia2pb :lia2pb_total_bits 2) smt))
(get-info :reason-unknown)
(check-sat-using (then simplify (using-params lia2pb :lia2pb_total_bits 3) smt))
(get-value ((and (>= x 6) (<= x 7))))
