(set-logic QF_UF)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const q Bool)
(assert (or p q))
(assert (not p))
(check-sat-using (using-params sat :max_conflicts 0))
(get-info :reason-unknown)
(check-sat-using (or-else (then (using-params sat :max_conflicts 0) fail-if-undecided) sat))
(get-value (p q))
