(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-proofs true)
(declare-const a (Array Bool Int Bool))
(declare-const b (Array Bool Int Bool))
(push 1)
(assert (= (select a ((_ array-ext 0) a b) ((_ array-ext 1) a b))
           (select b ((_ array-ext 0) a b) ((_ array-ext 1) a b))))
(check-sat)
(push 1)
(assert (distinct a b))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (distinct a b))
(check-sat)
(pop 1)
(check-sat)
