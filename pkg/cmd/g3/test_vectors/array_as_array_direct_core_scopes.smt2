(set-logic ALL)
(set-option :auto_config false)
(declare-sort U 0)
(declare-const i U)
(declare-const a (Array U Bool))
(declare-fun f (U) Bool)
(declare-const p Bool)
(push 1)
(assert (= a (_ as-array f)))
; Assumptions select the native incremental solver without tactic fallback.
(check-sat-assuming (p))
(push 1)
(assert (f i))
(assert (not (select a i)))
(check-sat-assuming (p))
(pop 1)
(check-sat-assuming (p))
