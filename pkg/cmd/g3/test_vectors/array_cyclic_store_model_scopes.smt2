(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(declare-const a (Array Bool Bool))
(assert (= a (store a true true)))
(check-sat)
(get-value ((select a true) (= a (store a true true))))
(push 1)
(assert (not (select a true)))
(check-sat)
(pop 1)
(check-sat)
(get-value ((select a true) (= a (store a true true))))
