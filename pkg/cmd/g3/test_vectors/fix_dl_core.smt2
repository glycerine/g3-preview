(set-option :produce-unsat-cores true)
(set-logic QF_IDL)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (! (<= (- x y) 2) :named forward))
(assert (! (<= (- y x) (- 3)) :named backward))
(assert (! (<= (- x z) 0) :named unrelated))
(check-sat-using (then simplify fix-dl-var smt))
(get-unsat-core)
