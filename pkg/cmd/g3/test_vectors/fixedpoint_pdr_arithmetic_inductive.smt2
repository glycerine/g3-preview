(set-option :fixedpoint.pdr.use_arith_inductive_generalizer true)
(set-option :fixedpoint.engine pdr)
(set-logic HORN)
(declare-rel Inv (Int))
(declare-rel Bad ())
(declare-var x Int)
(rule (Inv 0))
(rule (=> (Inv x) (Inv (- x 2))))
(rule (=> (and (Inv x) (>= x 2)) Bad))
(query Bad :print-answer true)
