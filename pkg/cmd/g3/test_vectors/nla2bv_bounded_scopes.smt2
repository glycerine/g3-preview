(set-option :produce-models true)
(set-logic ALL)
(declare-const x Int)
(assert (>= x 5))
(assert (<= x 8))
(assert (= (* x x) 49))
(check-sat-using (then nla2bv simplify bit-blast sat))
(get-value (x))
(push)
(assert (= x 6))
(check-sat-using (then nla2bv simplify bit-blast sat))
(pop)
(check-sat-using (then nla2bv simplify bit-blast sat))
(get-value (x))
