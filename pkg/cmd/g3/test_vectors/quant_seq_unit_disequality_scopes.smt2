(set-logic ALL)
(set-option :produce-unsat-cores true)
(declare-sort E 0)
(declare-const a E)
(declare-const b E)
(declare-const c E)
(declare-const d E)
(assert (! (not (= (seq.++ (seq.unit a) (seq.unit b)) (seq.++ (seq.unit c) (seq.unit d)))) :named words))
(push 1)
(assert (! (= b d) :named tail))
(assert (! (= a c) :named head))
(check-sat-using smt)
(get-unsat-core)
(pop 1)
(push 1)
(assert (= b d))
(assert (not (= a c)))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= a c))
(assert (not (= b d)))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= a c))
(assert (= b d))
(check-sat-using smt)
(pop 1)
