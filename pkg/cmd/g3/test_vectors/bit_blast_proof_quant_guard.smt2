(set-logic QF_BV)
(set-option :produce-proofs true)
(declare-const x (_ BitVec 4))
(assert (= x #x0))
(assert (= x #x1))
(check-sat-using (using-params bit-blast :blast_quant true))
(get-info :reason-unknown)
(check-sat-using (or-else (using-params bit-blast :blast_quant true) smt))
(check-sat-using (then bit-blast smt))
