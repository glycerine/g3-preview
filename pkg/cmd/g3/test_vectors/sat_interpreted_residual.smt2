(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const p Bool)
(assert (= x 2))
(assert (or p (> x 1)))
(assert (not p))
(check-sat-using sat)
(get-info :reason-unknown)
(check-sat-using (then sat smt))
(get-value (x p))
(push 1)
(assert (= x 3))
(check-sat-using (then sat smt))
(pop 1)
(check-sat-using (then sat-preprocess smt))
(get-value (x p))
