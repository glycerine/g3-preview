(set-option :smt.arith.propagation_mode 0)
(set-logic QF_UFLRA)
(declare-const x Real)
(declare-const y Real)
(assert (>= x 0))
(assert (<= y 2))
(check-sat)
(set-option :smt.arith.propagation_mode 2)
(push 1)
(assert (>= (+ x y) 5))
(assert (<= x 2))
(check-sat)
(pop 1)
(check-sat)
(set-option :smt.arith.propagation_mode 0)
(push 1)
(assert (< (+ x y) (- 10)))
(check-sat)
(pop 1)
(check-sat)
