(set-logic ALL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (>= x 0))
(assert (<= x 1))
(assert (>= y 0))
(assert (<= y 1))
(assert (>= z 0))
(assert (<= z 1))
(assert (>= (+ (* 2 x) (* 3 y) (* 4 z)) 9))
(check-sat-using (then simplify pb2bv smt))
(get-value (x y z))
(push 1)
(assert (= x 0))
(check-sat-using (then simplify pb2bv smt))
(pop 1)
(check-sat-using (then simplify pb2bv smt))
(get-value (x y z))
