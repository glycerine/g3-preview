(get-value ((> x 4)))
(push 1)
(assert (! (< x 0) :named impossible))
(check-sat-using smt)
(get-unsat-core)
(reset)
(check-sat-using smt)
(reset)
(set-logic QF_LRA)
(define-fun answer () Real 1)
(check-sat-using smt)
(reset)
(define-fun answer () Int 1)
(assert (= answer 1))
(check-sat-using smt)
(get-value (answer))
