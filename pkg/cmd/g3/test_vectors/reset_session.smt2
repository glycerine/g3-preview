(set-option :print-success true)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-logic QF_UF)
(declare-sort U 0)
(declare-const x U)
(assert (! (= x x) :named old))
(push 2)
(check-sat)
(reset)
(set-logic QF_LIA)
