(set-logic ALL)
(set-option :produce-models true)
(declare-datatypes ((BoolBox 0)) (((box (field Bool)) (empty))))
(declare-const p Bool)
(declare-const x BoolBox)
(assert (= x (box p)))
(check-sat-using smt)
(push)
(assert p)
(check-sat-using smt)
(get-value (p (field x) ((_ is box) x)))
(push)
(assert (not (field x)))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(pop)
(assert (not p))
(check-sat-using smt)
(get-value (p (field x) ((_ is box) x)))
(assert (= ((_ is box) x) (field x)))
(check-sat-using smt)
