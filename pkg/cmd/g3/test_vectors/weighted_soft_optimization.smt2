(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const a Bool)
(declare-const b Bool)
(declare-const x Int)

(push)
(assert (not (and a b)))
(assert-soft a)
(assert-soft b :weight 2)
(check-sat)
(get-objectives)
(get-value (a b))
(pop)

(push)
(assert (not (and a b)))
(assert-soft a :weight 1.5 :id first)
(assert-soft b :weight 2.25 :id second)
(check-sat)
(get-objectives)
(get-value (a b))
(pop)

(push)
(assert-soft a :weight -2)
(check-sat)
(get-objectives)
(get-value (a))
(pop)

(push)
(assert (and (>= x 0) (<= x 1)))
(assert-soft a :id soft-first)
(maximize x)
(assert-soft (not a) :weight 2 :id soft-last)
(check-sat)
(get-objectives)
(get-value (a x))
(pop)

(push)
(assert-soft a :weight 1 :id duplicate)
(assert-soft a :weight 2 :id duplicate)
(assert-soft (not a) :weight 2 :id duplicate)
(check-sat)
(get-objectives)
(get-value (a))
(pop)

(push)
(assert-soft a :weight 0 :id zero)
(check-sat)
(get-objectives)
(pop)
