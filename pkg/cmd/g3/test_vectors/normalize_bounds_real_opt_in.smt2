(set-logic QF_LRA)
(declare-const x Real)
(assert (> x (/ 1 3)))
(assert (<= x (/ 2 3)))
(check-sat-using (then (using-params normalize-bounds :norm_int_only false) smt))
(get-value ((and (> x (/ 1 3)) (<= x (/ 2 3)))))
(push 1)
(assert (<= x (/ 1 3)))
(check-sat-using (then (using-params normalize-bounds :norm_int_only false) smt))
(pop 1)
(check-sat-using (then (using-params normalize-bounds :norm_int_only false) smt))
