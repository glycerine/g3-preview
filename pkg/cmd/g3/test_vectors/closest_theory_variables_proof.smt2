(set-option :produce-proofs true)
(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-option :smt.core.validate true)
(set-logic ALL)
(declare-sort U 0)
(declare-fun f (U) Int)
(declare-const x0 U)
(declare-const x1 U)
(declare-const x2 U)
(declare-const x3 U)
(declare-const x4 U)
(assert (= x0 x1))
(assert (= x1 x2))
(assert (= x2 x3))
(assert (< (f x3) (f x4)))
(assert (! (= x3 x4) :named close_chain))
(check-sat)
(get-unsat-core)
(get-proof)
