(set-logic ALL)
(declare-const a (_ BitVec 4))
(declare-const b (_ BitVec 4))
(declare-const c (_ BitVec 4))
(declare-const d (_ BitVec 4))
(declare-const i Int)
(declare-const j Int)
(assert (bvsle a #x8))
(assert (bvsle #x7 b))
(assert (bvule c #xf))
(assert (bvule #xf d))
(assert (<= 4 i))
(assert (>= 8 j))
(check-sat-using (then elim-uncnstr smt))
(get-value ((bvsle a #x8) (bvsle #x7 b) (bvule c #xf) (bvule #xf d) (<= 4 i) (>= 8 j)))
