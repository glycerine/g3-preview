(set-option :ackermannization.sat_backend false)
(set-option :ackermannization.inc_sat_backend false)
(set-option :ackermannization.eager false)
(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (bvult x y))
(assert (bvult (f x) (f y)))
(check-sat-using qfufbv_ackr)
(get-value ((bvult x y) (bvult (f x) (f y))))
(push 1)
(assert (= (f x) (f y)))
(check-sat-using qfufbv_ackr)
(pop 1)
(check-sat-using qfufbv_ackr)
(get-value ((bvult x y) (bvult (f x) (f y))))
