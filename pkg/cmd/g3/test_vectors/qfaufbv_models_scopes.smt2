(set-logic QF_AUFBV)
(set-option :produce-models true)
(declare-const a (Array (_ BitVec 4) (_ BitVec 8)))
(declare-const i (_ BitVec 4))
(declare-const j (_ BitVec 4))
(declare-fun f ((_ BitVec 4)) (_ BitVec 8))
(assert (= (select a i) #x23))
(assert (= (select a j) #x45))
(assert (= (f i) (select a i)))
(assert (= (f j) (select a j)))
(assert (bvult i j))
(check-sat-using qfaufbv)
(get-value ((= (select a i) #x23) (= (select a j) #x45) (bvult (f i) (f j)) (bvult i j)))
(push 1)
(assert (= i j))
(check-sat-using qfaufbv)
(pop 1)
(check-sat-using qfaufbv)
(get-value ((= (select a i) #x23) (= (select a j) #x45) (bvult (f i) (f j))))
