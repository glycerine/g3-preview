(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.xform.slice true)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-logic HORN)
(declare-rel P (Int Int))
(declare-rel Goal ())
(declare-var x Int)
(declare-var y Int)
(rule (P 0 7))
(rule (=> (and (P x y) (= x 0)) Goal))
(query Goal :print-answer true)
