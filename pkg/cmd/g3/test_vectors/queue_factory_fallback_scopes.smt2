(set-logic QF_UF)
(set-option :auto-config true)
(set-option :smt.relevancy 1)
(set-option :smt.case_split 3)
(set-option :smt.phase_selection 4)
(set-option :smt.random_seed 7)
(set-option :produce-models true)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(assert (or a b))
(assert (or (not a) c))
(assert (or (not b) c))
(check-sat-using smt)
(get-value ((or a b) c))
(set-option :smt.case_split 4)
(set-option :smt.relevancy 2)
(set-option :smt.phase_selection 1)
(set-option :smt.random_seed 99)
(push 1)
(assert (not c))
(check-sat-using smt)
(pop 1)
(check-sat-using smt)
(set-option :smt.case_split 5)
(set-option :auto-config false)
(set-option :smt.phase_selection 0)
(push 1)
(assert (not a))
(check-sat-using smt)
(get-value (b c))
(pop 1)
(set-option :smt.case_split 3)
(set-option :smt.relevancy 1)
(set-option :auto-config true)
(set-option :smt.phase_selection 4)
(set-option :smt.random_seed 123)
(push 1)
(assert (and (not a) (not b)))
(check-sat-using smt)
(pop 1)
(set-option :smt.case_split 61)
(check-sat-using smt)
