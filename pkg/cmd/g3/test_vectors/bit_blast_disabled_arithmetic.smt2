(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= x #x1))
(assert (= y #x2))
(assert (= (bvmul x y) #x2))
(assert (= (bvadd x y) #x3))
(check-sat-using (then (using-params bit-blast :blast_add false :blast_mul false) smt))
(get-value (x y))
