(set-logic ALL)
(set-option :auto_config false)
(declare-sort U 0)
(declare-const u U)
(declare-fun f (U) Bool)
(declare-fun f (Bool) Bool)
(declare-const a (Array U Bool))
(declare-const b (Array Bool Bool))
(declare-const bits (Array Bool (_ BitVec 4)))
(push 1)
(assert (= a (_ as-array (f (U) Bool))))
(assert (f u))
(assert (not (select a u)))
(check-sat)
(pop 1)
(push 1)
(assert (select b true))
(assert (f true))
(assert (not (select ((_ map (f (Bool) Bool)) b) true)))
(check-sat)
(pop 1)
(push 1)
(assert (= (select bits true) #xa))
(assert (distinct (select ((_ map ((_ extract 1 0) ((_ BitVec 4)) (_ BitVec 2))) bits) true) #b10))
(check-sat)
(pop 1)
(check-sat)
