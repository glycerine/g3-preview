(set-logic ALL)
(set-option :produce-unsat-cores true)
(declare-const p String)
(declare-const q String)
(declare-const x String)
(declare-const y String)
(assert (! (not (= (str.++ p x) (str.++ q y))) :named words))
(push 1)
(assert (! (= p q) :named prefixes))
(assert (! (= x y) :named tails))
(check-sat-using smt)
(get-unsat-core)
(pop 1)
(push 1)
(assert (= p "a"))
(assert (= q "b"))
(assert (= x "z"))
(assert (= y "z"))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (! (= p q) :named prefixes_again))
(assert (! (= x y) :named tails_again))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= p "a"))
(assert (= q "a"))
(assert (= x "x"))
(assert (= y "y"))
(check-sat-using smt)
(pop 1)
