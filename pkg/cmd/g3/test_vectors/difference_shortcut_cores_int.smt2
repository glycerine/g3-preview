(set-option :auto_config false)
(set-option :smt.arith.solver 1)
(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-const e Int)
(assert (! (<= (- b a) 0) :named chain0))
(assert (! (<= (- c b) 0) :named chain1))
(assert (! (<= (- d c) 0) :named chain2))
(assert (! (<= (- e d) 0) :named chain3))
(check-sat-using smt)
(assert (! (<= (- d b) 1) :named near))
(assert (! (<= (- d a) 2) :named full))
(check-sat-using smt)
(push 1)
(assert (! (< (- a e) (- 2)) :named strict_close))
(check-sat-using smt)
(get-unsat-core)
(pop 1)
(check-sat-using smt)
(push 1)
(assert (! (<= (- a e) (- 2)) :named weak_close))
(check-sat-using smt)
(get-unsat-core)
(pop 1)
(check-sat-using smt)
