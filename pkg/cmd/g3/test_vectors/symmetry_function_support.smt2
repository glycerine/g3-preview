(set-logic QF_UF)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-fun f (U) U)
(assert (distinct a b))
(assert (or (= (f a) a) (= (f a) b)))
(assert (or (= (f b) a) (= (f b) b)))
(assert (distinct (f a) (f b)))
(check-sat-using (then symmetry-reduce smt))
(get-value ((distinct (f a) (f b))))
(push 1)
(assert (= (f a) (f b)))
(check-sat-using (then symmetry-reduce smt))
(pop 1)
(check-sat-using (then symmetry-reduce smt))
