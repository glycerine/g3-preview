(set-option :auto-config false)
(set-option :produce-models true)
(set-logic ALL)
(declare-const a (_ BitVec 4))
(declare-const b (_ BitVec 4))
(declare-const c (_ BitVec 4))
(declare-fun p ((_ BitVec 4)) Bool)
(assert (or (= a #xa) (= a #xb)))
(assert (= b #x3))
(assert (= c #x1))
(assert (p (bvadd a b c)))
(assert (not (p #xf)))
(check-sat-using smt)
(get-value (a (bvadd a b c) (bvsub a b) (bvmul a b c)
 (bvudiv a b) (bvurem a b) (bvsdiv a b) (bvsrem a b) (bvsmod a b)
 (bvshl a b) (bvlshr a b) (bvashr a b) (ext_rotate_left a b) (ext_rotate_right a b)
 (bvumul_noovfl a b) (bvsmul_noovfl a b) (bvsmul_noudfl a b)
 (bvredor a) (bvredand a)))
(push)
(assert (= a #xb))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(push)
(assert (not (= (bvadd a b c) (bvadd a (bvadd b c)))))
(check-sat-using smt)
(pop)
(check-sat-using smt)
