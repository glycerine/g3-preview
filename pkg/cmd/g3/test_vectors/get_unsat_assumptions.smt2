(set-option :produce-unsat-assumptions true)
(set-logic QF_UF)
(declare-const a Bool)
(declare-const b Bool)
(assert (not a))
(check-sat-assuming (a b))
(get-unsat-assumptions)
(push)
(assert (not b))
(check-sat-assuming (b))
(get-unsat-assumptions)
(pop)
(push)
(assert b)
(check-sat-assuming ((not b)))
(get-unsat-assumptions)
(pop)
(reset)
(set-logic QF_UF)
(declare-const a Bool)
(assert (not a))
(check-sat-assuming (a))
(get-unsat-assumptions)
