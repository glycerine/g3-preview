(set-logic QF_LIA)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (>= x 0))
(assert (<= x 3))
(assert (= y 2))
(assert (= (+ x y) 5))
(check-sat-using (then simplify lia2pb smt))
(get-info :reason-unknown)
(check-sat-using (then simplify (using-params lia2pb :lia2pb_partial true) smt))
(get-value (x y))
