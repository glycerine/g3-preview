(set-logic ALL)
(set-option :smt.arith.solver 4)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(push 1)
(assert (= (+ x y) 1.0))
(assert (= (- x y) 0.0))
(check-sat)
(get-value (x y))
(push 1)
(assert (distinct x y))
(check-sat)
(pop 1)
(check-sat)
(get-value (x y))
