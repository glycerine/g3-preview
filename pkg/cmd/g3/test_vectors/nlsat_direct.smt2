(set-logic QF_NRA)
(set-option :produce-models true)
(declare-const x Real)
(assert (= (* 2.0 x) 1.0))
(check-sat-using nlsat)
(get-value (x))
(reset)
(set-logic QF_NIA)
(declare-const x Int)
(assert (= (* 2 x) 1))
(check-sat-using (using-params nlsat :minimize_conflicts true :simplify_conflicts true))
(reset)
(set-logic QF_NRA)
(declare-const x Real)
(assert (= (* x x) 1.0))
(check-sat-using (using-params nlsat :factor true))
