(set-logic ALL)
(set-option :produce-unsat-cores true)
(declare-const x Int)
(declare-const y Int)
(assert (! (>= x 0) :named xlo))
(assert (! (<= x 2) :named xhi))
(assert (! (>= y 0) :named ylo))
(assert (! (<= y 2) :named yhi))
(assert (! (= (+ x y) 5) :named total))
(check-sat-using (then simplify lia2pb pb2bv smt))
(get-unsat-core)
