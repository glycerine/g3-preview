(set-logic QF_AX)
(declare-const a (Array Bool Bool Bool))
(declare-const b (Array Bool Bool Bool))
(declare-const i Bool)
(declare-const j Bool)
(declare-const k Bool)
(declare-const l Bool)
(declare-const v Bool)
(assert (= b (store a i j v)))
(assert (= i k))
(assert (distinct j l))
(check-sat)
(push 1)
(assert (distinct (select b k l) (select a k l)))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (distinct (select b i j) v))
(check-sat)
(pop 1)
(check-sat)
