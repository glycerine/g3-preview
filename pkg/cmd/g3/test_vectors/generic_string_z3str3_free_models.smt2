(set-logic ALL)
(set-option :produce-models true)
(declare-const s String)
(set-option :smt.string_solver z3str3)
(assert (not (= s "")))
(check-sat)
(get-value ((= s "")))
(push 1)
(assert (= (str.len s) 3))
(check-sat)
(get-value ((str.len s)))
(push 1)
(assert (= s ""))
(check-sat)
(pop 1)
(pop 1)
(push 1)
(assert (= s "abc"))
(check-sat)
(get-value (s))
(pop 1)
(check-sat)
(get-value ((= s "")))
