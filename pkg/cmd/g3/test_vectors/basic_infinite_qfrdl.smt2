(set-logic QF_RDL)
(set-option :smt.arith.solver 5)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(assert (<= (- x y) 1))
(assert (<= (- y x) 2))
(check-sat)
(get-value ((<= (- x y) 1) (<= (- y x) 2)))
(push 1)
(assert (<= (- x y) (- 3)))
(check-sat)
(pop 1)
(check-sat)
