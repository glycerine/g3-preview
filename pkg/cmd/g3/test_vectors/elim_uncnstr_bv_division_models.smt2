(set-logic QF_BV)
(declare-const a (_ BitVec 8))
(declare-const b (_ BitVec 8))
(declare-const c (_ BitVec 8))
(declare-const d (_ BitVec 8))
(declare-const x (_ BitVec 128))
(declare-const y (_ BitVec 8))
(assert (= (bvudiv a b) #x17))
(assert (= (bvsdiv c d) #xfd))
(assert (= (bvmul (_ bv3 128) x) (_ bv12 128)))
(assert (= (bvmul #x02 y) #x06))
(check-sat-using (then elim-uncnstr smt))
(get-value ((= (bvudiv a b) #x17) (= (bvsdiv c d) #xfd) (= (bvmul (_ bv3 128) x) (_ bv12 128)) (= (bvmul #x02 y) #x06)))
