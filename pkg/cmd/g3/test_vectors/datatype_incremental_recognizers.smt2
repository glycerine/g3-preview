(set-option :produce-models true)
(set-option :auto_config false)
(set-logic ALL)
(declare-datatypes () ((Choice (aa) (bb) (cc))))
(declare-const x Choice)
(declare-const y Choice)
(assert (= x y))
(assert (not ((_ is aa) x)))
(check-sat)
(get-value (((_ is aa) x) (= x y)))
(push 1)
(assert (not ((_ is bb) y)))
(check-sat)
(get-value (((_ is cc) x) ((_ is bb) y)))
(push 1)
(assert (not ((_ is cc) x)))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
