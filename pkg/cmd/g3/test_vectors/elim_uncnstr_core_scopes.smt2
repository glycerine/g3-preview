(set-option :produce-unsat-cores true)
(set-logic QF_UF)
(declare-const a Bool)
(declare-const b Bool)
(assert (! (not a) :named negative))
(assert (! (or a b) :named disjunction))
(check-sat-using (then elim-uncnstr smt))
(get-value ((not a) (or a b)))
(push 1)
(assert (! (not b) :named other))
(check-sat-using (then elim-uncnstr smt))
(get-unsat-core)
(pop 1)
(check-sat-using (then elim-uncnstr smt))
(get-value ((not a) (or a b)))
