(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= (bvudiv x y) #x2))
(assert (= x #x6))
(assert (= y #x3))
(check-sat-using bit-blast)
(get-info :reason-unknown)
(check-sat-using (or-else bit-blast (then simplify bit-blast smt)))
(get-value (x y))
