(set-logic QF_UFLRA)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(declare-fun f (Real) Real)
(assert (distinct (f x) (f z)))
(check-sat-using smt)
(get-value ((distinct (f x) (f z)) (distinct x z)))
(push)
(assert (<= x y))
(assert (<= y z))
(assert (<= z x))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(get-value ((distinct (f x) (f z)) (distinct x z)))
