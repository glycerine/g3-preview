(set-option :produce-models true)
(set-option :auto_config false)
(set-logic ALL)
(declare-datatypes () ((Nat (z) (s (prev Nat)))))
(declare-const x Nat)
(declare-const y Nat)
(assert (= y (s x)))
(check-sat)
(get-value (((_ is z) x) ((_ is s) y)))
(push 1)
(assert (not ((_ is z) x)))
(check-sat)
(get-value (((_ is z) x) ((_ is s) y)))
(push 1)
(assert (not ((_ is s) y)))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
