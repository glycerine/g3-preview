(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(declare-const w (_ BitVec 8))
(assert (= (bvadd x y) #x03))
(assert (= (bvadd y z x w) #x0a))
(assert (= x #x01))
(assert (= y #x02))
(assert (= z #x03))
(assert (= w #x04))
(check-sat-using (then max-bv-sharing smt))
(get-value (x y z w))
(push 1)
(assert (= (bvxor x y z w) #xff))
(check-sat-using (then max-bv-sharing smt))
(pop 1)
(check-sat-using (then (using-params max-bv-sharing :max_args 2) smt))
(get-value (x y z w))
