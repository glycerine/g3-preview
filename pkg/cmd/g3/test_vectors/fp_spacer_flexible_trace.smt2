(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.pdr.flexible_trace true)
(set-option :fixedpoint.pdr.flexible_trace_depth 2)
(set-option :fixedpoint.spacer.use_lemma_as_cti true)
(set-option :fixedpoint.spacer.reset_obligation_queue false)
(set-option :fixedpoint.spacer.reuse_pobs false)
(set-option :fixedpoint.spacer.simplify_pob true)
(set-option :fixedpoint.spacer.blast_term_ite false)
(set-option :fixedpoint.spacer.init_reach_facts false)
(set-option :fixedpoint.spacer.reach_as_init false)
(set-option :fixedpoint.spacer.use_derivations false)
(set-option :fixedpoint.spacer.order_children 1)
(declare-rel Inv (Int))
(declare-rel Bad ())
(declare-var x Int)
(declare-var y Int)
(rule (=> (and (Inv x) (= y (+ x 1))) (Inv y)))
(rule (=> (and (Inv x) (< x 0)) Bad))
(query Bad :print-answer false)
