(set-logic ALL)
(set-option :auto_config false)
(set-option :smt.arith.solver 4)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(assert (> (+ x y) 0.0))
(assert (< (+ x y) (/ 1.0 3.0)))
(assert (= (- x y) 0.0))
(check-sat)
(get-value ((> (+ x y) 0.0) (< (+ x y) (/ 1.0 3.0)) (= x y)))
(push 1)
(assert (<= (+ x y) 0.0))
(check-sat)
(pop 1)
(check-sat)
(get-value ((> (+ x y) 0.0) (< (+ x y) (/ 1.0 3.0)) (= x y)))
