(set-logic AUFLIA)
(set-option :produce-unsat-cores true)
(declare-fun f (Int) Int)
(assert (! (forall ((x Int)) (! (>= (f x) x) :pattern ((f x)))) :named axiom))
(assert (! (< (f 0) 0) :named negative))
(check-sat-using smt)
(get-unsat-core)
(check-sat-using auflia)
(get-unsat-core)
(check-sat)
(get-unsat-core)
