(set-logic QF_FPBV)
(set-option :produce-models true)
(declare-const x (_ FloatingPoint 3 4))
(declare-const rm RoundingMode)
(assert (= rm RNA))
(push)
(assert (= x (fp #b1 #b011 #b001)))
(check-sat)
(get-value ((= (fp.to_ieee_bv x) #b1011001) (fp.isNormal x) (= rm RNA)))
(push)
(assert (fp.isZero x))
(check-sat)
(pop 2)
(push)
(assert (= x (_ -zero 3 4)))
(check-sat)
(get-value ((fp.isZero x) (fp.isNegative x)))
(pop)
(push)
(assert (fp.isNaN x))
(check-sat)
(get-value ((fp.isNaN x) (= rm RNA)))
(pop)
