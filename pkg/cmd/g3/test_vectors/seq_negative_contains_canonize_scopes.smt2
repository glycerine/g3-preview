(set-logic ALL)
(set-option :produce-models true)
(declare-const x String)
(declare-const y String)
(declare-const n Int)
(assert (not (str.contains x "a")))
(check-sat-using smt)
(push 1)
(assert (= x (str.++ y "a")))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= x "zz"))
(check-sat-using smt)
(get-value ((not (str.contains x "a"))))
(pop 1)
(push 1)
(assert (not (str.contains x y)))
(assert (str.prefixof y x))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= n 7))
(assert (= x (int.to.str n)))
(check-sat-using smt)
(get-value ((= x "7")))
(pop 1)
(check-sat-using smt)
