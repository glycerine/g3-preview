(set-logic QF_BV)
(set-option :produce-models true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(assert (= (bvmul x y) #x6))
(assert (bvult x y))
(check-sat-using qfbv)
(get-value ((= (bvmul x y) #x6) (bvult x y)))
(push 1)
(assert (bvult y x))
(check-sat-using qfbv)
(pop 1)
(check-sat-using qfbv)
(get-value ((= (bvmul x y) #x6) (bvult x y)))
