(set-option :produce-models true)
(set-option :global-declarations true)
(set-logic ALL)
(declare-const x Int)
(assert (= (* x x) 2))
(check-sat-using (then nla2bv simplify bit-blast sat))
(reset-assertions)
(assert (= (* x x) 4))
(check-sat-using (then nla2bv simplify bit-blast sat))
(get-value ((= (* x x) 4)))
