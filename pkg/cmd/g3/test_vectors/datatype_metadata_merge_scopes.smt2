(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-option :smt.core.validate true)
(set-logic ALL)
(declare-sort U 0)
(declare-datatypes () ((Choice (left (lf U)) (middle (mf U)) (right (rf U)))))
(declare-const u U)
(declare-const v U)
(declare-const x Choice)
(declare-const y Choice)
(assert (not ((_ is left) x)))
(assert (not ((_ is middle) y)))
(push 1)
(assert (= x y))
(check-sat)
(get-value (((_ is right) x) ((_ is right) y) (= x y)))
(push 1)
(assert (! (not ((_ is right) y)) :named rejected_survivor))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
(get-value ((not ((_ is left) x)) (not ((_ is middle) y))))
(push 1)
(assert (! (= x (left u)) :named rejected_constructor))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(push 1)
(assert (= x (right u)))
(assert (= y (right v)))
(assert (= x y))
(check-sat)
(get-value ((= u v) (= (rf x) u) (= (rf y) v)))
(pop 1)
(check-sat)
