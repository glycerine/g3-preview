(set-logic QF_UFIDL)
(set-option :produce-models true)
(declare-sort U 0)
(declare-const u U)
(declare-const v U)
(declare-fun f (U) Int)
(assert (>= (f u) 3))
(assert (<= (f v) 2))
(check-sat)
(get-value ((>= (f u) 3) (<= (f v) 2) (distinct u v)))
(push 1)
(assert (= u v))
(check-sat)
(pop 1)
(check-sat)
(get-value ((>= (f u) 3) (<= (f v) 2) (distinct u v)))
