(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :auto_config false)
(set-option :smt.core.validate true)
(set-logic ALL)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const p Bool)
(declare-const q Bool)
(assert a)
(assert (=> a b))
(assert (or (not b) (not c) p q))
(assert (or (not b) (not c) p (not q)))
(assert (or (not b) (not c) (not p) q))
(assert (or (not b) (not c) (not p) (not q)))
(check-sat-assuming (a c))
(get-unsat-core)
(check-sat-assuming (a (not c)))
(get-value (a b c))
(push 1)
(assert (! c :named blocked))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat-assuming ((not c)))
(declare-sort U 0)
(declare-const x U)
(declare-const y U)
(declare-const z U)
(declare-const e Bool)
(declare-const h Bool)
(assert e)
(assert (=> e (= x y)))
(assert (=> h (= y z)))
(assert (=> h (distinct x z)))
(check-sat-assuming (e h))
(get-unsat-core)
(check-sat-assuming (e (not h)))
(get-value (e h (= x y)))
(push 1)
(assert (! h :named blocked_eq))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat-assuming ((not h)))
