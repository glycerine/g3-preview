(set-logic QF_UFBV)
(set-option :produce-unsat-cores true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(assert (! (= x y) :named eq))
(assert (! (not (= (f x) (f y))) :named conflict))
(check-sat-using ackermannize_bv)
(get-info :reason-unknown)
(check-sat-using (or-else ackermannize_bv smt))
(get-unsat-core)
