(set-option :produce-proofs true)
(set-logic ALL)
(declare-sort U 0)
(declare-datatypes () ((Choice (left (lf U)) (middle (mf U)) (right (rf U)))))
(declare-const u U)
(declare-const x Choice)
(assert (= x (left u)))
(assert (not ((_ is left) x)))
(check-sat-using (using-params smt :auto_config false))
(get-proof)
