(set-option :produce-unsat-cores true)
(set-logic QF_DT)
(declare-datatypes () ((Tree leaf (fork (left Tree) (right Tree)))))
(declare-const x Tree)
(declare-const y Tree)
(declare-const z Tree)
(push 1)
(assert (! (= x (fork y leaf)) :named x_edge))
(assert (! (= y (fork z leaf)) :named y_edge))
(assert (! (= z (fork leaf x)) :named z_edge))
(check-sat)
(get-unsat-core)
(pop 1)
(push 1)
(assert (= y (fork leaf leaf)))
(assert (= x (fork y y)))
(check-sat)
(get-value ((= (left x) (right x)) (= (left (left x)) leaf)))
(push 1)
(assert (= z (fork z leaf)))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(check-sat)
