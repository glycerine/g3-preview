(set-logic QF_NRA)
(set-option :smt.arith.nl.gb false)
(set-option :smt.arith.nl.branching false)
(declare-const x Real)
(declare-const y Real)
(push 1)
(assert (> y 0))
(assert (<= (+ (* (/ 1 2) x x y) (* (- 1) x y) (* (/ 3 2) y)) 0))
(check-sat)
(pop 1)
(push 1)
(assert (<= (+ (* 3 x x x x) (* (- 6) x x) 4) 0))
(check-sat)
(pop 1)
(assert (= x 1))
(assert (= y 2))
(check-sat)
(get-value (x y (+ (* (/ 1 2) x x y) (* (- 1) x y) (* (/ 3 2) y))))
