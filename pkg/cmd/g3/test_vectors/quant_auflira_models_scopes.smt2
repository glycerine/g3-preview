(set-logic AUFLIRA)
(set-option :produce-models true)
(declare-fun f (Real) Real)
(declare-const x Real)
(declare-const i Int)
(assert (forall ((t Real)) (>= (f t) t)))
(assert (= x (f 3)))
(assert (<= x 5))
(assert (= i 4))
(check-sat)
(get-value ((>= x 3) (= i 4)))
(check-sat-using auflira)
(get-value ((>= x 3) (= i 4)))
(push 1)
(assert (< (f 0) 0))
(check-sat)
(pop 1)
(check-sat)
(get-value ((>= x 3) (= i 4)))
