(set-logic QF_S)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (= (str.++ x (str.++ y z)) "ab"))
(assert (not (and (= x "") (= (str.++ y z) "ab"))))
(assert (not (and (= x "a") (= (str.++ y z) "b"))))
(assert (not (and (= x "ab") (= (str.++ y z) ""))))
(check-sat)
