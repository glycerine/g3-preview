(set-option :auto_config false)
(set-option :smt.arith.solver 5)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(declare-const i Int)
(declare-const r Real)
(declare-fun f (Real) Real)
(assert (>= i 0))
(assert (<= i 2))
(assert (> r 0))
(assert (< r (/ 1.0 3.0)))
(assert (distinct (f r) (f (/ 1.0 2.0))))
(check-sat)
(get-value ((>= i 0) (<= i 2) (> r 0) (< r (/ 1.0 3.0)) (distinct (f r) (f (/ 1.0 2.0)))))
(push 1)
(assert (! (>= r (/ 1.0 2.0)) :named real_conflict))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(push 1)
(assert (! (= (to_real i) (/ 1.0 2.0)) :named integer_conflict))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(push 1)
(assert (= r (/ 1.0 4.0)))
(assert (= (* r r) (/ 1.0 16.0)))
(check-sat)
(get-value ((= (* r r) (/ 1.0 16.0))))
(pop 1)
(check-sat)
