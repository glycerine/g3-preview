(set-option :auto-config false)
(set-option :produce-models true)
(set-option :produce-proofs true)
(set-logic QF_UFBV)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(assert (= ((_ extract 0 0) x) #b1))
(assert (= ((_ extract 1 1) x) #b0))
(assert (= ((_ extract 2 2) x) #b0))
(assert (= ((_ extract 3 3) x) #b1))
(push)
(assert (= ((_ extract 0 0) y) #b1))
(assert (= ((_ extract 1 1) y) #b0))
(assert (= ((_ extract 2 2) y) #b0))
(assert (= ((_ extract 3 3) y) #b1))
(check-sat-using smt)
(get-value ((= x #x9) (= y #x9) (= x y)))
(push)
(assert (distinct (f x) (f y)))
(check-sat-using smt)
(pop)
(check-sat-using smt)
(pop)
(push)
(assert (= ((_ extract 0 0) y) #b0))
(assert (= ((_ extract 1 1) y) #b1))
(assert (= ((_ extract 2 2) y) #b0))
(assert (= ((_ extract 3 3) y) #b1))
(assert (distinct (f x) (f y)))
(check-sat-using smt)
(get-value ((= x #x9) (= y #xa) (distinct x y) (distinct (f x) (f y))))
(pop)
(check-sat-using smt)
