(set-option :produce-models true)
(set-option :opt.priority pareto)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(assert (and (>= x 0) (<= x 3) (>= y 0) (<= y 3)))
(maximize x)
(maximize y)
(check-sat)
(get-objectives)
(get-value (x y))
(check-sat)
(check-sat)
(get-objectives)
(get-value (x y))
