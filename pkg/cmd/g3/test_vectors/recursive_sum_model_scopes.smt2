(set-option :produce-models true)
(set-logic AUFLIA)
(define-fun-rec sum ((n Int)) Int (ite (<= n 0) 0 (+ n (sum (- n 1)))))
(assert (= (sum 3) 6))
(check-sat-using (using-params smt :auto_config false))
(get-value ((sum 0) (sum 3) (sum 5)))
(push 1)
(assert (not (= (sum 4) 10)))
(check-sat-using (using-params smt :auto_config false))
(pop 1)
(check-sat-using (using-params smt :auto_config false))
(get-value ((sum 6)))
