(set-option :produce-proofs true)
(set-logic QF_NRA)
(declare-const x Real)
(declare-const y Real)
(declare-const unrelated Real)
(assert (>= x 1.0))
(assert (<= x 3.0))
(assert (>= y 1.0))
(assert (<= y 3.0))
(assert (>= unrelated 999.0))
(push 1)
(assert (<= (* x y) 5.0))
(check-sat)
(push 1)
(assert (= x 3.0))
(assert (= y 3.0))
(check-sat)
(pop 1)
(check-sat)
(pop 1)
(push 1)
(assert (> x 2.0))
(assert (>= y 2.0))
(assert (<= (* x y) 4.0))
(check-sat)
(pop 1)
(check-sat)
