(set-logic QF_UFBV)
(set-option :produce-models true)
(declare-fun f ((_ BitVec 4)) (_ BitVec 4))
(assert (= (f #x0) #x1))
(assert (= (f #x1) #x2))
(assert (= (f #x2) #x3))
(check-sat-using (using-params ackermannize_bv :div0_ackermann_limit 1))
(get-info :reason-unknown)
(check-sat-using (then (using-params ackermannize_bv :div0_ackermann_limit 1) smt))
(get-value ((f #x0) (f #x1) (f #x2)))
