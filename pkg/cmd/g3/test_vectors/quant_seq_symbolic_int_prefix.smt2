(set-logic ALL)
(set-option :produce-models true)
(declare-const x String)
(declare-const z String)
(declare-const w String)
(declare-const n Int)
(assert (>= n 0))
(assert (= (str.++ x z) (str.++ (int.to.str n) w)))
(assert (= z "b"))
(assert (= w "ab"))
(assert (not (= x "")))
(assert (not (= x (int.to.str n))))
(check-sat-using smt)
(get-value ((= x (str.++ (int.to.str n) "a"))))
(push 1)
(assert (= x (int.to.str n)))
(check-sat-using smt)
(pop 1)
(push 1)
(assert (= n 7))
(check-sat-using smt)
(get-value ((= x "7a")))
(pop 1)
(check-sat-using smt)
