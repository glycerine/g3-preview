; Fixed-factor premises must survive basis elimination and scope pops.
(set-option :produce-proofs true)
(set-logic QF_NRA)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(declare-const k Real)
(declare-const unrelated Real)
(assert (>= unrelated 77.0))
(push 1)
(assert (= k 2.0))
(assert (= (* k x y) 1.0))
(assert (= (* x z) 2.0))
(assert (= (+ y z) 0.0))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= k (- 0.5)))
(assert (= x 1.0))
(assert (= y (- 2.0)))
(assert (= z 2.0))
(assert (= (* k x y) 1.0))
(assert (= (* x z) 2.0))
(assert (= (+ y z) 0.0))
(check-sat)
(pop 1)
