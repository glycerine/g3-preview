(set-logic QF_NRA)
(declare-const x Real)
(assert (= (* x x) (- 1.0)))
(check-sat)
(reset)
(set-logic QF_NRA)
(declare-const x Real)
(assert (= (* x x) 2.0))
(check-sat-using qfnra)
(reset)
(set-logic QF_NRA)
(declare-const x Real)
(assert (> x 0.0))
(assert (< x 0.0))
(check-sat-using qfnra)
(reset)
(set-logic QF_NRA)
(declare-const p Bool)
(declare-const x Real)
(assert (= (ite p (* x x) 0.0) 2.0))
(check-sat-using qfnra)
