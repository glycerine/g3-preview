(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-option :smt.core.validate true)
(set-logic ALL)
(declare-const p Bool)
(declare-const q Bool)
(assert (or p q))
(check-sat-assuming ((not p) (not q)))
(get-unsat-core)
(check-sat-assuming ((not p)))
(push 1)
(assert (not p))
(assert (! (not q) :named blocked))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat-assuming ((not q)))
(check-sat)
