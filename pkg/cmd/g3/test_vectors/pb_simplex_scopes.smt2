(set-option :auto_config false)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :smt.core.validate true)
(set-option :smt.pb.enable_simplex true)
(set-logic ALL)
(declare-const x Bool)
(declare-const y Bool)
(declare-const z Bool)
(define-fun XY () Bool ((_ pbge 1 1 1) x y))
(define-fun YZ () Bool ((_ pbge 1 1 1) y z))
(define-fun XZ () Bool ((_ pbge 1 1 1) x z))
(define-fun Cap () Bool ((_ at-most 1) x y z))
(push 1)
(assert (! XY :named pair_xy))
(assert (! YZ :named pair_yz))
(assert (! XZ :named pair_xz))
(assert (! Cap :named cap_one))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(define-fun Two () Bool ((_ pbge 2 1 1 1) x y z))
(define-fun Three () Bool ((_ pbge 3 1 1 1) x y z))
(push 1)
(assert (! (not Two) :named below_two))
(assert (! Three :named at_least_three))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(define-fun Parent () Bool ((_ pbge 2 1 1) x y))
(define-fun Nested () Bool ((_ pbeq 1 1 1) Parent z))
(push 1)
(assert Parent)
(assert Nested)
(assert (not z))
(check-sat)
(get-value (x y z Parent Nested))
(pop 1)
(check-sat)
