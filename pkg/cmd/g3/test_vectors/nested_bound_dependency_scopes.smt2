(set-option :produce-proofs true)
(set-logic QF_NRA)
(declare-const x Real)
(declare-const p Real)
(declare-const q Real)
(declare-const unrelated Real)
(assert (= p (* x x)))
(assert (= q (* 2.0 x)))
(assert (>= unrelated 99.0))
(assert (>= x 2.0))
(push 1)
(assert (<= (+ p 2.0) q))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (> x 1.0))
(assert (<= (- (* x x) x) 0.0))
(check-sat)
(pop 1)
(check-sat)
