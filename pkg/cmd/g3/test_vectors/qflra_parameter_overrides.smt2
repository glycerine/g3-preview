(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (>= (+ x y) 1))
(assert (>= (+ x (* 2 y)) 3))
(check-sat-using (using-params qflra :auto_config false))
(check-sat-using qflra)
(get-value ((and (>= (+ x y) 1) (>= (+ x (* 2 y)) 3))))
(check-sat-using (using-params qflra :arith.greatest_error_pivot false))
