(set-logic ALL)
(set-option :auto_config false)
(set-option :produce-models true)
(set-option :smt.macro_finder true)
(declare-const c Bool)
(declare-fun f (Bool) Bool)
(push 1)
(assert (forall ((x Bool)) (= (f x) (and x c))))
(check-sat)
(get-value (c (f false) (f true)))
(push 1)
(assert c)
(check-sat)
(get-value (c (f false) (f true)))
(pop 1)
(check-sat)
(get-value (c (f false) (f true)))
