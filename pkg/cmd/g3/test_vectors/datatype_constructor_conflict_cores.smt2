(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-logic ALL)
(declare-sort U 0)
(declare-datatypes () ((Choice (left (lf U)) (middle (mf U)) (right (rf U)))))
(declare-const u U)
(declare-const x Choice)
(assert (! (= x (left u)) :named left_fact))
(check-sat)
(get-value (((_ is left) x) (= (lf x) u)))
(push 1)
(assert (! (not ((_ is left) x)) :named not_left))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
(push 1)
(assert (! (= x (right u)) :named right_fact))
(check-sat)
(get-unsat-core)
(pop 1)
(check-sat)
