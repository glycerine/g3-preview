(set-logic QF_IDL)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(assert (and (>= x 0) (<= x 100) (>= y 0) (<= y 100)))
(assert (= (- x y) 37))
(check-sat-using qfidl)
(get-value ((and (= (- x y) 37) (>= x 0) (<= x 100) (>= y 0) (<= y 100))))
(push 1)
(assert (<= (- x y) 36))
(check-sat-using qfidl)
(pop 1)
(check-sat-using qfidl)
(get-value ((= (- x y) 37)))
