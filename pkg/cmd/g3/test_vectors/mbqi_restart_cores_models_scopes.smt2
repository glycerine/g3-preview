(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-logic AUFLIA)
(declare-fun p (Bool) Bool)
(declare-const a Bool)
(declare-const b Bool)
(assert (forall ((x Bool)) (p x)))
(assert (or a b))
(push 1)
(assert (! (not (p true)) :named blocked_true))
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-unsat-core)
(pop 1)
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-value ((p true) (p false)))
(push 1)
(assert (! (not (p false)) :named blocked_false))
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-unsat-core)
(pop 1)
(check-sat-using (using-params smt :auto_config false :ematching false))
(get-value ((p true) (p false)))
