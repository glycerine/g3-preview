(set-logic QF_LRA)
(set-option :produce-models true)
(declare-const x Real)
(declare-const p Bool)
(declare-const q Bool)
(define-fun threshold () Real 3906.255859375)
(assert (or (and p q) (>= x threshold)))
(assert (not p))
(assert (= x threshold))
(check-sat)
(get-value ((= x threshold)))
(push 1)
(assert (< x threshold))
(check-sat)
(pop 1)
(check-sat)
(get-value ((= x threshold)))
