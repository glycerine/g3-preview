(set-logic QF_UF)
(set-option :auto_config false)
(set-option :produce-models true)
(declare-fun f (Bool) Bool)
(push 1)
(assert (not (f false)))
(assert (not (f true)))
(check-sat)
(get-model)
(set-option :model.compact true)
(check-sat)
(get-model)
(get-value ((f false) (f true)))
(set-option :model.compact false)
(check-sat)
(get-model)
