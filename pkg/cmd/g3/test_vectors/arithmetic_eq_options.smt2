(set-logic QF_UFLRA)
(set-option :smt.arith.propagate_eqs false)
(declare-const x Real)
(declare-const y Real)
(declare-fun f (Real) Real)
(assert (>= x 1))
(assert (>= y 1))
(assert (distinct (f x) (f y)))
(push 1)
(assert (<= (+ x y) 2))
(check-sat)
(pop 1)
(check-sat)
(set-option :smt.arith.propagate_eqs true)
(push 1)
(assert (<= (+ x y) 2))
(check-sat)
(pop 1)
(check-sat)
(set-option :smt.arith.propagate_eqs false)
(push 1)
(assert (<= (+ x y) 2))
(check-sat)
(pop 1)
(check-sat)
