(set-option :auto_config false)
(set-option :smt.arith.solver 1)
(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(assert (<= x 2))
(assert (<= y 3))
(maximize (+ (* 2 x) (* 3 y) 7))
(check-sat)
(get-objectives)
(get-value ((= x 2) (= y 3)))
(push 1)
(assert (<= x 1))
(check-sat)
(get-objectives)
(pop 1)
(check-sat)
(get-objectives)
