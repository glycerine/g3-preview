(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (>= x 0))
(assert (< x 3))
(assert (>= y 0))
(assert (<= y 2))
(maximize (+ 3 (* 2 x) (- y)))
(check-sat)
(get-objectives)
(get-value ((< x 3) (>= x 0) (>= y 0) (<= y 2)))
(get-info :all-statistics)
(push)
(assert (<= x 2))
(check-sat)
(get-objectives)
(pop)
(check-sat)
(get-objectives)
(push)
(assert (< x 0))
(check-sat)
(pop)
(check-sat)
