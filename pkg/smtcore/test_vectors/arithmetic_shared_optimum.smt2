(set-option :auto_config false)
(set-option :smt.arith.solver 2)
(set-option :produce-models true)
(set-logic QF_UFLRA)
(declare-const x Real)
(declare-fun f (Real) Real)
(assert (distinct (f x) (f 5)))
(assert (<= x 5))
(maximize x)
(check-sat)
(get-objectives)
(get-value ((< x 5) (distinct (f x) (f 5))))
