(set-option :smt.arith.propagate_eqs false)
(set-logic QF_UFLRA)
(declare-const x Real)
(declare-const y Real)
(declare-fun f (Real) Real)
(assert (>= x 7))
(assert (<= x 7))
(assert (>= y 7))
(assert (<= y 7))
(push)
(assert (distinct (f x) (f y)))
(check-sat)
(get-info :all-statistics)
(pop)
(check-sat)
(get-value ((= x y) (= (f x) (f y))))
