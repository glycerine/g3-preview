(set-logic QF_UFLRA)
(declare-const x Real)
(declare-const y Real)
(assert (>= x 0))
(assert (<= x 4))
(assert (<= y 2))
(assert (>= (+ x y) 5))
(check-sat)
(get-value ((>= x 0) (<= x 4) (<= y 2) (>= (+ x y) 5)))
(push)
(assert (<= x 2))
(check-sat)
(pop)
(check-sat)
(get-value ((>= x 0) (<= x 4) (<= y 2) (>= (+ x y) 5)))
(get-info :all-statistics)
