(set-option :auto_config false)
(set-option :smt.arith.solver 2)
(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (>= x 0))
(assert (>= y 0))
(assert (<= (+ (* 2 x) y) 10))
(assert (<= (+ x (* 2 y)) 10))
(maximize (+ x y))
(check-sat)
(get-objectives)
(push)
(assert (<= x 1))
(check-sat)
(get-objectives)
(pop)
(check-sat)
(get-objectives)
