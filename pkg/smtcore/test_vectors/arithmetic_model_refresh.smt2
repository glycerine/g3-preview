(set-option :auto_config false)
(set-option :smt.arith.solver 2)
(set-option :produce-models true)
(set-logic QF_LRA)
(declare-const x Real)
(assert (< x 5))
(maximize (+ (* 2 x) 1))
(check-sat)
(get-value (x (+ (* 2 x) 1)))
(reset)
(set-logic QF_LIA)
(declare-const x Int)
(assert (<= (* 2 x) 7))
(maximize (+ (* 2 x) 1))
(check-sat)
(get-value (x (+ (* 2 x) 1)))
