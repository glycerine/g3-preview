digraph packages {
  rankdir=LR;
  graph [bgcolor=white, pad=0.25];
  node [shape=box, fontname="sans-serif", fontsize=11];
  edge [color="#7a8793"];
  label="Go production imports: consumer -> dependency";
  labelloc=t;
  "arena" [style=filled, fillcolor="#c9e8cb"];
  "util/approx" [style=filled, fillcolor="#dceafa"];
  "util/backtrack" [style=filled, fillcolor="#dceafa"];
  "util/bitset" [style=filled, fillcolor="#dceafa"];
  "util/bitset" -> "arena";
  "util/checkedint" [style=filled, fillcolor="#dceafa"];
  "util/cliques" [style=filled, fillcolor="#dceafa"];
  "util/control" [style=filled, fillcolor="#dceafa"];
  "util/control" -> "arena";
  "util/control" -> "util/messages";
  "util/cooperate" [style=filled, fillcolor="#dceafa"];
  "util/cooperate" -> "arena";
  "util/diagnostic" [style=filled, fillcolor="#dceafa"];
  "util/diagnostic" -> "arena";
  "util/diagnostic" -> "util/memory";
  "util/diagnostic" -> "util/text";
  "util/diagnostic" -> "util/z3exception";
  "util/escaped" [style=filled, fillcolor="#dceafa"];
  "util/filepath" [style=filled, fillcolor="#dceafa"];
  "util/hash" [style=filled, fillcolor="#dceafa"];
  "util/hash/runtime" [style=filled, fillcolor="#dceafa"];
  "util/hash/runtime" -> "arena";
  "util/hash/runtime" -> "util/hash";
  "util/hash/runtime" -> "util/memory";
  "util/heap" [style=filled, fillcolor="#dceafa"];
  "util/heap" -> "arena";
  "util/idgen" [style=filled, fillcolor="#dceafa"];
  "util/idgen" -> "arena";
  "util/lbool" [style=filled, fillcolor="#dceafa"];
  "util/lp" [style=filled, fillcolor="#dceafa"];
  "util/lp" -> "arena";
  "util/lp" -> "util/numeral";
  "util/lp" -> "util/params";
  "util/lp" -> "util/random";
  "util/lp" -> "util/stopwatch";
  "util/luby" [style=filled, fillcolor="#dceafa"];
  "util/memory" [style=filled, fillcolor="#dceafa"];
  "util/memory" -> "arena";
  "util/messages" [style=filled, fillcolor="#dceafa"];
  "util/mincut" [style=filled, fillcolor="#dceafa"];
  "util/natset" [style=filled, fillcolor="#dceafa"];
  "util/numeral" [style=filled, fillcolor="#dceafa"];
  "util/numeral" -> "arena";
  "util/numeral" -> "util/hash";
  "util/numeral" -> "util/memory";
  "util/numeral" -> "util/text";
  "util/params" [style=filled, fillcolor="#dceafa"];
  "util/params" -> "arena";
  "util/params" -> "util/diagnostic";
  "util/params" -> "util/memory";
  "util/params" -> "util/numeral";
  "util/params" -> "util/symbol";
  "util/params" -> "util/text";
  "util/params" -> "util/z3exception";
  "util/prime" [style=filled, fillcolor="#dceafa"];
  "util/prime" -> "arena";
  "util/process" [style=filled, fillcolor="#dceafa"];
  "util/process" -> "arena";
  "util/process" -> "util/diagnostic";
  "util/process" -> "util/memory";
  "util/process" -> "util/numeral";
  "util/process" -> "util/params";
  "util/process" -> "util/prime";
  "util/process" -> "util/symbol";
  "util/productiter" [style=filled, fillcolor="#dceafa"];
  "util/random" [style=filled, fillcolor="#dceafa"];
  "util/sexpr" [style=filled, fillcolor="#dceafa"];
  "util/sexpr" -> "arena";
  "util/sexpr" -> "util/numeral";
  "util/sexpr" -> "util/symbol";
  "util/sexpr" -> "util/text";
  "util/smallint" [style=filled, fillcolor="#dceafa"];
  "util/smt2" [style=filled, fillcolor="#dceafa"];
  "util/smt2" -> "arena";
  "util/smt2" -> "util/symbol";
  "util/smt2" -> "util/text";
  "util/stack" [style=filled, fillcolor="#dceafa"];
  "util/stack" -> "arena";
  "util/statistics" [style=filled, fillcolor="#dceafa"];
  "util/statistics" -> "arena";
  "util/statistics" -> "util/memory";
  "util/stopwatch" [style=filled, fillcolor="#dceafa"];
  "util/stopwatch" -> "util/memory";
  "util/symbol" [style=filled, fillcolor="#dceafa"];
  "util/symbol" -> "arena";
  "util/symbol" -> "util/hash";
  "util/text" [style=filled, fillcolor="#dceafa"];
  "util/text" -> "arena";
  "util/version" [style=filled, fillcolor="#dceafa"];
  "util/z3exception" [style=filled, fillcolor="#dceafa"];
}
